---
import '@fontsource/nixie-one';
import '@fontsource/outfit';
import '@fontsource/atkinson-hyperlegible';
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import MobileNav from '../components/MobileNav.astro';
import Skyline from '../components/Skyline.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'R03montia 的个人站点。' } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="R03montia" href="/rss.xml" />
    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('theme');
        const dark = saved ? saved === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.toggleAttribute('data-theme', dark);
        if (dark) document.documentElement.setAttribute('data-theme', 'dark');
        const savedRain = localStorage.getItem('rain');
        const rainy = savedRain ? savedRain === 'on' : true;
        document.documentElement.toggleAttribute('data-rainy', rainy);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到主内容</a>
    <div class="app">
      <Sidebar />
      <main id="main-content" class="main-area">
        <slot />
      </main>
    </div>
    <div class="silhouettes" aria-hidden="true" transition:persist>
      <div class="sky-l1"><Skyline /></div>
    </div>
    <div class="rain-overlay" aria-hidden="true" transition:persist></div>
    <slot name="after-main" />
    <MobileNav />
    <script>
      const toggleTheme = () => {
        const root = document.documentElement;
        const dark = root.getAttribute('data-theme') !== 'dark';
        if (dark) root.setAttribute('data-theme', 'dark');
        else root.removeAttribute('data-theme');
        localStorage.setItem('theme', dark ? 'dark' : 'light');
      };
      const syncRain = () => {
        const on = document.documentElement.hasAttribute('data-rainy');
        document.querySelectorAll('.rain-label').forEach((el) => {
          el.textContent = on ? '开' : '关';
        });
      };
      const toggleRain = () => {
        const root = document.documentElement;
        if (root.hasAttribute('data-rainy')) root.removeAttribute('data-rainy');
        else root.setAttribute('data-rainy', '');
        localStorage.setItem('rain', root.hasAttribute('data-rainy') ? 'on' : 'off');
        syncRain();
      };
      document.getElementById('theme-toggle')?.addEventListener('click', toggleTheme);
      document.getElementById('theme-toggle-mobile')?.addEventListener('click', toggleTheme);
      document.getElementById('rain-toggle')?.addEventListener('click', toggleRain);
      document.getElementById('rain-toggle-mobile')?.addEventListener('click', toggleRain);
      syncRain();

      // Astro 切页时 swapRootAttributes 会剥掉 <html> 上除 data-astro-transition*
      // 之外的全部属性，再用新文档的属性覆盖。新文档是构建时静态产物，
      // data-theme / data-rainy 是 head 脚本运行时才设的，没法在 HTML 里。
      // 解决：在 swap 前把当前 <html> 上的这两个属性复制到 newDocument 的根上，
      // swap 会把它们一起沿用过来。同步 syncRain 是因为持久化 MobileNav 的
      // 「开/关」文字标签也是构建时的旧值，需要按当前实际状态刷新。
      const persistThemeRain = (event: Event) => {
        const newDoc = (event as CustomEvent & { newDocument?: Document }).newDocument;
        if (!newDoc) return;
        const cur = document.documentElement;
        const next = newDoc.documentElement;
        if (cur.hasAttribute('data-theme')) {
          next.setAttribute('data-theme', cur.getAttribute('data-theme')!);
        }
        if (cur.hasAttribute('data-rainy')) {
          next.setAttribute('data-rainy', '');
        }
      };
      document.addEventListener('astro:before-swap', persistThemeRain);

      // 持久化导航的 active 高亮：transition:persist 让侧栏/底栏不重渲染，
      // 但导航高亮是构建时按 URL 算的，需要在切页后根据新 URL 重新同步。
      const updateNavActive = () => {
        const path = location.pathname;
        const isActive = (href: string) =>
          href === '/' ? path === '/' : path.startsWith(href);
        document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]').forEach((a) => {
          const href = a.getAttribute('href') || '';
          const active = isActive(href);
          a.classList.toggle('active', active);
          if (active) a.setAttribute('aria-current', 'page');
          else a.removeAttribute('aria-current');
        });
      };
      document.addEventListener('astro:after-swap', updateNavActive);
      updateNavActive();
    </script>
    <style is:global>
      /* 页面切换：模糊淡入淡出 */
      ::view-transition-old(root),
      ::view-transition-new(root) {
        animation-duration: 220ms;
        animation-timing-function: ease-out;
      }
      ::view-transition-old(root) {
        animation-name: page-blur-out;
      }
      ::view-transition-new(root) {
        animation-name: page-blur-in;
      }
      @keyframes page-blur-out {
        to { opacity: 0; filter: blur(4px); }
      }
      @keyframes page-blur-in {
        from { opacity: 0; filter: blur(8px); }
      }
      @media (prefers-reduced-motion: reduce) {
        ::view-transition-old(root),
        ::view-transition-new(root) {
          animation: none !important;
        }
      }
    </style>
  </body>
</html>

<style>
  .app { display: flex; min-height: 100vh; }
  .main-area {
    flex: 1;
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 60rem;
    margin: 0 auto;
    padding: 2.5rem 1.5rem calc(5rem + env(safe-area-inset-bottom));
  }
  @media (max-width: 48rem) {
    .app { display: block; }
    :global(.sidebar) { display: none; }
    .main-area { padding-top: 1.5rem; }
  }
</style>