---
import '@fontsource/nixie-one';
import '@fontsource/outfit';
import '@fontsource/atkinson-hyperlegible';
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import Skyline from '../components/Skyline.astro';
import Live2DWidget from '../components/Live2DWidget.astro';
import { ClientRouter } from 'astro:transitions';
import { INSIDE_AUTH_STORAGE_KEY, INSIDE_AUTH_TOKEN } from '../utils/inside-auth';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  /** 独立挂机模式：隐藏常规栏架，仅保留全站氛围层。 */
  idle?: boolean;
}
const {
  title,
  description = 'R03montia 的个人站点。',
  ogImage = '/og.jpg',
  ogType = 'website',
  idle = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
const insideAuthVars = {
  INSIDE_AUTH_STORAGE_KEY,
  INSIDE_AUTH_TOKEN,
};
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="R03montia" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="theme-color" content="#cdd4dc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#12151a" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <link rel="alternate" type="application/rss+xml" title="R03montia" href="/rss.xml" />
    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
      (() => {
        if (
          'serviceWorker' in navigator &&
          !/^(localhost|127\.|0\.0\.0\.0|\[::1\])$/.test(location.hostname) &&
          !/^192\.168\.|^10\.|^172\.(1[6-9]|2[0-9]|3[01])\./.test(location.hostname)
        ) {
          window.addEventListener('load', () => {
            navigator.serviceWorker.register('/sw.js').catch(() => {});
          });
        }
      })();
    </script>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('theme');
        const dark = saved ? saved === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        if (dark) document.documentElement.setAttribute('data-theme', 'dark');
        const savedRain = localStorage.getItem('rain');
        const rainy = savedRain ? savedRain === 'on' : true;
        document.documentElement.toggleAttribute('data-rainy', rainy);
      })();
    </script>
  </head>
  <body class:list={{ 'idle-active': idle }}>
    <a class="skip-link" href="#main-content">跳到主内容</a>
    <div class="app">
      {!idle && <Sidebar />}
      <main id="main-content" class:list={['main-area', { 'idle-main': idle }]}>
        <slot />
      </main>
    </div>
    <div class="silhouettes" aria-hidden="true" transition:persist>
      <div class="sky-l2"><Skyline /></div>
      <div class="sky-l1"><Skyline /></div>
    </div>
    <div class="rain-overlay" aria-hidden="true" transition:persist></div>
    <slot name="after-main" />
    {!idle && (
      <header class="mobile-topbar">
        <button id="menu-toggle" type="button" aria-controls="main-sidebar" aria-expanded="false" aria-label="打开菜单">
          <span class="hamb"><span></span><span></span><span></span></span>
        </button>
        <a class="mobile-brand" href="/">R03montia</a>
      </header>
    )}
    {!idle && <div id="drawer-backdrop"></div>}
    {!idle && (
      <button id="back-to-top" type="button" aria-label="回到顶部" title="回到顶部">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 19V5" /><path d="M5 12l7-7 7 7" />
        </svg>
      </button>
    )}
    <Live2DWidget />
    <script is:inline define:vars={insideAuthVars}>
      window.__insideAuth = {
        isAuthorized: () => {
          try {
            return localStorage.getItem(INSIDE_AUTH_STORAGE_KEY) === INSIDE_AUTH_TOKEN;
          } catch {
            return false;
          }
        },
        gateUrl: (next = '/inside/') =>
          `/inside-gate/?next=${encodeURIComponent(next)}`,
      };
    </script>
    <script>
      const toggleTheme = () => {
        const root = document.documentElement;
        const dark = root.getAttribute('data-theme') !== 'dark';
        if (dark) root.setAttribute('data-theme', 'dark');
        else root.removeAttribute('data-theme');
        localStorage.setItem('theme', dark ? 'dark' : 'light');
      };
      const syncRain = () => {
        const on = document.documentElement.hasAttribute('data-rainy');
        const btn = document.getElementById('rain-toggle');
        if (btn) btn.setAttribute('aria-label', on ? '关闭下雨效果' : '开启下雨效果');
      };
      const toggleRain = () => {
        const root = document.documentElement;
        if (root.hasAttribute('data-rainy')) root.removeAttribute('data-rainy');
        else root.setAttribute('data-rainy', '');
        localStorage.setItem('rain', root.hasAttribute('data-rainy') ? 'on' : 'off');
        syncRain();
      };
      syncRain();

      // Astro 切页时 swapRootAttributes 会剥掉 <html> 上除 data-astro-transition*
      // 之外的全部属性，再用新文档的属性覆盖。新文档是构建时静态产物，
      // data-theme / data-rainy 是 head 脚本运行时才设的，没法在 HTML 里。
      // 解决：在 swap 前把当前 <html> 上的这两个属性复制到 newDocument 的根上，
      // swap 会把它们一起沿用过来。同步 syncRain 是为了让按钮 aria-label
      // 跟当前实际状态一致（图标显隐由 CSS :not([data-rainy]) 处理）。
      const persistThemeRain = (event: Event) => {
        const newDoc = (event as CustomEvent & { newDocument?: Document }).newDocument;
        if (!newDoc) return;
        const cur = document.documentElement;
        const next = newDoc.documentElement;
        if (cur.hasAttribute('data-theme')) {
          next.setAttribute('data-theme', cur.getAttribute('data-theme')!);
        }
        if (cur.hasAttribute('data-rainy')) {
          next.setAttribute('data-rainy', '');
        }
      };
      // 持久化导航的 active 高亮：transition:persist 让侧栏/底栏不重渲染，
      // 但导航高亮是构建时按 URL 算的，需要在切页后根据新 URL 重新同步。
      const updateNavActive = () => {
        const path = location.pathname;
        const isActive = (href: string) =>
          href === '/' ? path === '/' : path.startsWith(href);
        document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]').forEach((a) => {
          const href = a.getAttribute('href') || '';
          const active = isActive(href);
          a.classList.toggle('active', active);
          if (active) a.setAttribute('aria-current', 'page');
          else a.removeAttribute('aria-current');
        });
      };
      // 博客正文图片懒加载：构建时 markdown 渲染不带 loading 属性，
      // 在客户端一次性补上，避免长文首屏刷流量。
      const lazyProseImages = () => {
        document.querySelectorAll<HTMLImageElement>('.prose img').forEach((img) => {
          if (!img.hasAttribute('loading')) img.setAttribute('loading', 'lazy');
          if (!img.hasAttribute('decoding')) img.setAttribute('decoding', 'async');
        });
      };
      // 代码块右上角复制按钮：构建产物里没有，客户端插入。
      const enhanceCodeBlocks = () => {
        document.querySelectorAll<HTMLPreElement>('.prose pre').forEach((pre) => {
          if (pre.querySelector('.copy-btn')) return;
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'copy-btn';
          btn.textContent = '复制';
          btn.setAttribute('aria-label', '复制代码');
          btn.addEventListener('click', async () => {
            const text = pre.innerText.replace(/\n?复制$/, '');
            try {
              await navigator.clipboard.writeText(text);
              btn.textContent = '已复制';
              setTimeout(() => { btn.textContent = '复制'; }, 1200);
            } catch {
              btn.textContent = '失败';
              setTimeout(() => { btn.textContent = '复制'; }, 1200);
            }
          });
          pre.appendChild(btn);
        });
      };
      // 外链新窗口 + ↗ 角标：只对 .prose 内的正文链接做，导航/按钮不动。
      const markExternalLinks = () => {
        document.querySelectorAll<HTMLAnchorElement>('.prose a[href^="http"]').forEach((a) => {
          if (a.hostname === location.hostname) return;
          a.setAttribute('target', '_blank');
          a.setAttribute('rel', 'noopener noreferrer');
          if (!a.querySelector('.ext-icon')) {
            const icon = document.createElement('span');
            icon.className = 'ext-icon';
            icon.setAttribute('aria-hidden', 'true');
            icon.textContent = '↗';
            a.appendChild(icon);
          }
        });
      };
      // 里版·夜 触发:页面滚到底后累计下拽（电脑端滚轮 5 次 / 移动端触屏 3 次）,坠入夜晚。
      // 每次下拽整页轻微下沉 + 变暗作张力提示;触发后只播 body 级的
      // "night-fall" 动画(不加 data-night — 否则表版会闪出旧里版皮肤),
      // 动画中段按设备记忆分流:已记住的设备直达里版,新设备先到密码门。
      const enterNight = () => {
        type InsideAuthBridge = {
          isAuthorized: () => boolean;
          gateUrl: (next?: string) => string;
        };
        const insideAuthBridge = (window as unknown as { __insideAuth?: InsideAuthBridge }).__insideAuth;
        document.body.classList.remove('night-hint-1', 'night-hint-2', 'night-hint-3');
        document.body.classList.add('night-enter');
        setTimeout(() => {
          window.location.href = insideAuthBridge?.isAuthorized()
            ? '/inside/'
            : insideAuthBridge?.gateUrl('/inside/') ?? '/inside-gate/?next=%2Finside%2F';
        }, 350);
      };
      // 电脑端防误触：滚轮短时间内的连续 tick 先累积量，攒够一格稍多（110px）才算一次下拽，
      // 且两次计数之间至少隔 500ms——用力一滚 mostly 只算一次，想进里版得到底停稳后、
      // 一下一下有节奏地拽 4 次；触底后需停稳 500ms 才开始计数（过滤触底惯性）。
      // 底部判定带迟滞：滚轮微回跳 / 触控板抖动导致的那几像素上滑不算“离开底部”，
      // 计数和下沉提示都保留（之前是离底 1px 就 whole 清零，视觉上就是刚沉下去又弹回来）。
      const WHEEL_PULLS_NEEDED = 4;
      const WHEEL_SETTLE_MS = 500;
      const WHEEL_PULL_GAP_MS = 500;
      const WHEEL_BURST_RESET_MS = 400;
      const WHEEL_PULL_MIN_PX = 110;
      // 手机端：手指是精细控制、没有滚轮惯性，门槛放低——触底停稳 250ms 即可，
      // 允许“滑到底不停手、继续上拽”的连贯手势（中途到达底部也算），攒够 48px 算一次，连拽 3 次进入。
      const TOUCH_PULLS_NEEDED = 3;
      const TOUCH_SETTLE_MS = 250;
      const TOUCH_PULL_GAP_MS = 300;
      const NIGHT_PULL_WINDOW_MS = 5000;
      let wheelPullCount = 0;
      let touchPullCount = 0;
      let wheelPullTimer: ReturnType<typeof setTimeout> | null = null;
      let touchPullTimer: ReturnType<typeof setTimeout> | null = null;
      let nightLockUntil = 0;
      let lastWheelPullAt = 0;
      let lastTouchPullAt = 0;
      let wheelAccum = 0;
      let wheelBurstTimer: ReturnType<typeof setTimeout> | null = null;
      let bottomSettledAt = 0;
      const resetNightPull = () => {
        wheelPullCount = 0;
        touchPullCount = 0;
        document.body.classList.remove('night-hint-1', 'night-hint-2', 'night-hint-3');
      };
      const syncNightHint = () => {
        const progress = Math.max(
          wheelPullCount / WHEEL_PULLS_NEEDED,
          touchPullCount / TOUCH_PULLS_NEEDED,
        );
        const hintLevel = Math.ceil(progress * 3);
        document.body.classList.add('night-hint');
        document.body.classList.remove('night-hint-1', 'night-hint-2', 'night-hint-3');
        document.body.classList.add(`night-hint-${Math.min(Math.max(hintLevel, 1), 3)}`);
      };
      const isAtBottom = () => {
        const doc = document.documentElement;
        // 下拉提示会给 body 加 transform；浏览器可能因此在底部再挤出几像素滚动空间。
        // 用 32px 容差，避免刚触发提示就被误判成“不在底部”而清空计数。
        return doc.scrollTop + doc.clientHeight >= doc.scrollHeight - 32;
      };
      // 离底超过这个距离才算真离开（清零计数、提示与停稳计时）；32~160px 的抖动带内保持一切不动。
      const BOTTOM_LEAVE_PX = 160;
      const isFarFromBottom = () => {
        const doc = document.documentElement;
        return doc.scrollTop + doc.clientHeight < doc.scrollHeight - BOTTOM_LEAVE_PX;
      };
      const syncBottomSettled = () => {
        if (isAtBottom()) {
          if (!bottomSettledAt) bottomSettledAt = Date.now();
        } else if (isFarFromBottom()) {
          bottomSettledAt = 0;
          resetNightPull();
        }
        // 抖动带内：什么都不做，保留计数、提示与停稳计时。
      };
      // 返回是否真正计上数：防误触拦截（未停稳 / 间隔太短）时返回 false，调用方不消耗这次手势。
      const registerNightPull = (source: 'wheel' | 'touch'): boolean => {
        const now = Date.now();
        if (document.documentElement.hasAttribute('data-night')) return false;
        if (now < nightLockUntil) return false;
        // 不在底部只拦这一次，不 whole 清零（抖动时进度保留）；真离开底部的清零交给 scroll 监听。
        if (!isAtBottom()) return false;
        const settle = source === 'touch' ? TOUCH_SETTLE_MS : WHEEL_SETTLE_MS;
        const gap = source === 'touch' ? TOUCH_PULL_GAP_MS : WHEEL_PULL_GAP_MS;
        if (!bottomSettledAt || now - bottomSettledAt < settle) return false;
        if (source === 'wheel') {
          if (now - lastWheelPullAt < gap) return false;
          lastWheelPullAt = now;
          wheelPullCount += 1;
        } else {
          if (now - lastTouchPullAt < gap) return false;
          lastTouchPullAt = now;
          touchPullCount += 1;
        }
        syncNightHint();
        const needed = source === 'wheel' ? WHEEL_PULLS_NEEDED : TOUCH_PULLS_NEEDED;
        const count = source === 'wheel' ? wheelPullCount : touchPullCount;
        if (source === 'wheel') {
          if (wheelPullTimer) clearTimeout(wheelPullTimer);
          wheelPullTimer = setTimeout(resetNightPull, NIGHT_PULL_WINDOW_MS);
        } else {
          if (touchPullTimer) clearTimeout(touchPullTimer);
          touchPullTimer = setTimeout(resetNightPull, NIGHT_PULL_WINDOW_MS);
        }
        if (count >= needed) {
          nightLockUntil = Date.now() + 1000;
          resetNightPull();
          enterNight();
        }
        return true;
      };
      const onNightWheel = (e: WheelEvent) => {
        if (e.deltaY <= 0) return;
        // 攒够一格稍多算一次；一次猛滚的连发 tick 大部分被间隔合并消耗掉，只算一次。
        wheelAccum += e.deltaY;
        if (wheelBurstTimer) clearTimeout(wheelBurstTimer);
        wheelBurstTimer = setTimeout(() => { wheelAccum = 0; }, WHEEL_BURST_RESET_MS);
        if (wheelAccum < WHEEL_PULL_MIN_PX) return;
        wheelAccum = 0;
        registerNightPull('wheel');
      };
      // 移动端触屏版：wheel 事件在触屏上不会触发，所以用触摸手势补齐。
      // 手指上滑（内容继续往下拽）时累计距离，达标立刻计一次并给下沉提示，不用等松手；
      // 允许“滑到底不停手、继续上拽”的连贯手势（中途到达底部也算）；
      // 一次触摸最多计一次，松手时若滑动达标但还没计过则补计。
      // 被防误触拦截（未停稳 / 间隔太短）时不消耗这次触摸，可在同一次触摸里继续拽。
      const TOUCH_PULL_MIN_PX = 40;
      const TOUCH_PULL_ACCUM_PX = 48;
      let touchPullStartY: number | null = null;
      let touchPullLastY: number | null = null;
      let touchPullAccum = 0;
      let touchPullCounted = false;
      const onNightTouchStart = (e: TouchEvent) => {
        const first = e.touches[0];
        touchPullStartY = first ? first.clientY : null;
        touchPullLastY = touchPullStartY;
        touchPullAccum = 0;
        touchPullCounted = false;
      };
      const onNightTouchMove = (e: TouchEvent) => {
        if (touchPullStartY == null || touchPullLastY == null) return;
        if (touchPullCounted) return;
        const cur = e.touches[0];
        if (!cur) return;
        const dy = touchPullLastY - cur.clientY; // 手指上移为正
        touchPullLastY = cur.clientY;
        if (dy <= 0) return;
        if (isFarFromBottom()) { touchPullAccum = 0; return; }
        if (!isAtBottom()) return;
        touchPullAccum += dy;
        if (touchPullAccum >= TOUCH_PULL_ACCUM_PX) {
          if (registerNightPull('touch')) {
            touchPullCounted = true;
          } else {
            touchPullAccum = 0;
          }
        }
      };
      const onNightTouchEnd = (e: TouchEvent) => {
        if (touchPullStartY == null) return;
        const last = e.changedTouches[0];
        const endY = last ? last.clientY : touchPullStartY;
        const swipeUp = touchPullStartY - endY;
        touchPullStartY = null;
        touchPullLastY = null;
        if (touchPullCounted) return;
        if (swipeUp < TOUCH_PULL_MIN_PX) return;
        if (!isAtBottom()) return;
        if (registerNightPull('touch')) touchPullCounted = true;
      };
      // 返回顶部按钮：滚动超一屏淡入。
      const syncBackToTop = () => {
        const btn = document.getElementById('back-to-top');
        if (!btn) return;
        btn.classList.toggle('visible', window.scrollY > window.innerHeight);
      };
      // 站内搜索：pagefind 在 build 后产生 /pagefind/ 索引,运行时按需 import。
      // 开发模式没构建索引,降级为隐藏空态提示。
      type PagefindResult = { data: () => Promise<{ url: string; excerpt: string; meta: { title?: string } }> };
      type Pagefind = { search: (q: string) => Promise<{ results: PagefindResult[] }> };
      type TagEntry = { tag: string; count: number };
      let tagsPromise: Promise<TagEntry[]> | null = null;
      const loadTags = (): Promise<TagEntry[]> => {
        if (!tagsPromise) {
          tagsPromise = fetch('/tags.json', { cache: 'force-cache' })
            .then((r) => (r.ok ? r.json() : []))
            .catch(() => []);
        }
        return tagsPromise;
      };
      // 标题加权：标题命中（完全相等 > 开头命中 > 包含）的排前面，正文命中沉底。
      const scoreByTitle = (title: string, q: string): number => {
        const t = title.toLowerCase();
        const needle = q.toLowerCase();
        if (t === needle) return 3;
        if (t.startsWith(needle)) return 2;
        if (t.includes(needle)) return 1;
        return 0;
      };
// 标题命中高亮：转义后把查询词包上主题色 mark。
const escHtml = (s: string): string =>
  s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] ?? c));
const highlightTitle = (title: string, q: string): string => {
  let h = escHtml(title);
  const words = Array.from(new Set(q.split(/\s+/).filter(Boolean))).sort((a, b) => b.length - a.length).slice(0, 5);
  for (const w of words) {
    const e = escHtml(w).replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    try { h = h.replace(new RegExp(`(${e})`, 'gi'), '<mark>$1</mark>'); } catch { /* 非法正则时跳过 */ }
  }
  return h;
};
      let pagefindPromise: Promise<Pagefind> | null = null;
      const loadPagefind = (): Promise<Pagefind> => {
        if (!pagefindPromise) {
          // 构建期 /pagefind/ 还没生成,Rollup 无法静态解析,用 Function 延迟到运行时
          const dynamicImport = new Function('u', 'return import(u)') as (u: string) => Promise<unknown>;
          pagefindPromise = dynamicImport('/pagefind/pagefind.js') as Promise<Pagefind>;
        }
        return pagefindPromise;
      };
      const initSearch = () => {
        const input = document.getElementById('site-search') as HTMLInputElement | null;
        const panel = document.getElementById('search-results') as HTMLElement | null;
        if (!input || !panel) return;
        if ((input as HTMLInputElement & { __bound?: boolean }).__bound) return;
        (input as HTMLInputElement & { __bound?: boolean }).__bound = true;
        let timer: ReturnType<typeof setTimeout> | undefined;
        const close = () => { panel.classList.remove('open'); panel.innerHTML = ''; };
        input.addEventListener('input', () => {
          clearTimeout(timer);
          const q = input.value.trim();
          if (!q) { close(); return; }
          timer = setTimeout(async () => {
            try {
              // #xxx 显式标签直达；不带 # 但和标签名完全相同的也直达。
              const tagQuery = q.startsWith('#') ? q.slice(1).trim() : q;
              const tags = tagQuery ? await loadTags() : [];
              const hitTag = tagQuery
                ? tags.find((t) => t.tag.toLowerCase() === tagQuery.toLowerCase())
                : undefined;
              const tagCard = hitTag
                ? `<a class="sr-tag" href="/tag/${encodeURIComponent(hitTag.tag)}/"><div class="sr-title">#${hitTag.tag} · 标签直达</div></a>`
                : '';
              const pf = await loadPagefind();
              // # 搜索时去掉 # 再查正文，避免符号干扰 pagefind。
              const res = await pf.search(tagQuery || q);
              const all = await Promise.all(res.results.slice(0, 12).map((r) => r.data()));
              const items = all
                .filter((d) => !d.url.startsWith('/inside/'))
                .map((d, i) => ({ d, i }))
                .sort((a, b) =>
                  scoreByTitle(b.d.meta?.title ?? '', tagQuery || q) -
                    scoreByTitle(a.d.meta?.title ?? '', tagQuery || q) || a.i - b.i,
                )
                .map(({ d }) => d)
                .slice(0, 8);
              if (!tagCard && items.length === 0) {
                panel.innerHTML = '<div class="sr-empty">没有匹配的结果，换个关键词试试</div>';
              } else {
                panel.innerHTML = tagCard + items
                  .map((d) => `<a href="${d.url}"><div class="sr-title">${highlightTitle(d.meta?.title ?? d.url, tagQuery || q)}</div></a>`)
                  .join('');
              }
              panel.classList.add('open');
            } catch {
              panel.innerHTML = '<div class="sr-empty">搜索索引未生成（需 npm run build)</div>';
              panel.classList.add('open');
            }
          }, 200);
        });
        input.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') { input.value = ''; close(); input.blur(); }
        });
        document.addEventListener('click', (e) => {
          if (!(e.target as Element | null)?.closest('.side-search')) close();
        });
        panel.addEventListener('click', (e) => {
          const a = (e.target as Element | null)?.closest('a');
          if (a) { input.value = ''; close(); }
        });
      };
      // 移动端汉堡抽屉 + 明暗/雨开关：全部用 document 事件委托，并通过 window
      // 一次性标记保证只在首帧绑定一次。Astro 切页时模块脚本会重跑：直接给
      // 元素绑监听会让持久化元素（侧栏开关按钮）叠加监听；而新页面按钮在
      // ~220ms 过渡期间还没绑上监听，导致"偶尔点汉堡没反应"。委托 + 只绑一次两者兼治。
      if (!(window as unknown as { __siteUI?: boolean }).__siteUI) {
        (window as unknown as { __siteUI: boolean }).__siteUI = true;
        const setMenu = (open: boolean) => {
          const root = document.body;
          root.classList.toggle('menu-open', open);
          root.style.overflow = open ? 'hidden' : '';
          const toggler = document.getElementById('menu-toggle');
          toggler?.setAttribute('aria-expanded', String(open));
          toggler?.setAttribute('aria-label', open ? '关闭菜单' : '打开菜单');
        };
        document.addEventListener('click', (e) => {
          const el = e.target as Element | null;
          const hit = (sel: string) => el?.closest(sel);
          if (hit('#menu-toggle')) setMenu(!document.body.classList.contains('menu-open'));
          else if (hit('#drawer-backdrop')) setMenu(false);
          else if (hit('[data-nav-link]')) setMenu(false);
          else if (hit('#theme-toggle')) toggleTheme();
          else if (hit('#rain-toggle')) toggleRain();
          else if (hit('#back-to-top')) window.scrollTo({ top: 0, behavior: 'smooth' });
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') setMenu(false);
        });
        window.addEventListener('scroll', syncBackToTop, { passive: true });
        if (!bottomSettledAt && isAtBottom()) bottomSettledAt = Date.now();
        window.addEventListener('scroll', syncBottomSettled, { passive: true });
        window.addEventListener('wheel', onNightWheel, { passive: true });
        window.addEventListener('touchstart', onNightTouchStart, { passive: true });
        window.addEventListener('touchmove', onNightTouchMove, { passive: true });
        window.addEventListener('touchend', onNightTouchEnd, { passive: true });
        document.addEventListener('astro:before-swap', persistThemeRain);
        document.addEventListener('astro:after-swap', () => {
          setMenu(false);
          updateNavActive();
          lazyProseImages();
          enhanceCodeBlocks();
          markExternalLinks();
          syncBackToTop();
          initSearch();
        });
      }
      updateNavActive();
      lazyProseImages();
      enhanceCodeBlocks();
      markExternalLinks();
      syncBackToTop();
      initSearch();
    </script>
    <style is:global>
      /* 页面切换：模糊淡入淡出 */
      ::view-transition-old(root),
      ::view-transition-new(root) {
        animation-duration: 220ms;
        animation-timing-function: ease-out;
      }
      ::view-transition-old(root) {
        animation-name: page-blur-out;
      }
      ::view-transition-new(root) {
        animation-name: page-blur-in;
      }
      @keyframes page-blur-out {
        to { opacity: 0; filter: blur(4px); }
      }
      @keyframes page-blur-in {
        from { opacity: 0; filter: blur(8px); }
      }
      @media (prefers-reduced-motion: reduce) {
        ::view-transition-old(root),
        ::view-transition-new(root) {
          animation: none !important;
        }
      }
    </style>
    <style is:global>
      .mobile-topbar { display: none; }
      #drawer-backdrop { display: none; }
      @media (max-width: 48rem) {
        .mobile-topbar {
          display: flex;
          align-items: center;
          gap: 0.6rem;
          position: fixed;
          top: 0;
          left: 0;
          right: 0;
          height: 3.2rem;
          z-index: 40;
          padding: 0 1rem;
          background: rgb(var(--content-bg) / 0.45);
          backdrop-filter: blur(1rem);
          -webkit-backdrop-filter: blur(1rem);
          box-shadow: 0 0 1.5rem -0.75rem rgba(0, 0, 0, 0.4);
          border-bottom: 1px solid rgb(var(--line) / 0.4);
          color: rgb(var(--text));
          font-family: var(--font-ui);
          font-size: 1rem;
        }
        .mobile-brand { color: inherit; letter-spacing: 0.05em; font-size: 1.05rem; }
        .mobile-topbar button#menu-toggle {
          display: flex;
          align-items: center;
          justify-content: center;
          width: 2.75rem;
          height: 2.75rem;
          flex-shrink: 0;
          padding: 0;
          border: 1px solid rgb(var(--line) / 0.4);
          border-radius: 8px;
          background: rgb(var(--content-bg) / 0.5);
          color: rgb(var(--text));
          cursor: pointer;
          touch-action: manipulation;
        }
        .hamb { position: relative; display: block; width: 18px; height: 14px; }
        .hamb span {
          position: absolute;
          left: 0;
          width: 18px;
          height: 2px;
          background: currentColor;
          border-radius: 1px;
          transition: top 0.2s ease-out, transform 0.2s ease-out, opacity 0.2s ease-out;
        }
        .hamb span:nth-child(1) { top: 0; }
        .hamb span:nth-child(2) { top: 6px; }
        .hamb span:nth-child(3) { top: 12px; }
        body.menu-open .hamb span:nth-child(1) { top: 6px; transform: rotate(45deg); }
        body.menu-open .hamb span:nth-child(2) { opacity: 0; }
        body.menu-open .hamb span:nth-child(3) { top: 6px; transform: rotate(-45deg); }

        #main-sidebar {
          position: fixed;
          top: 0;
          bottom: 0;
          left: 0;
          width: min(15rem, 82vw);
          z-index: 30;
          height: auto;
          transform: translateX(-100%);
          visibility: hidden;
          transition: transform 0.25s ease-out, visibility 0.25s;
          background: rgb(var(--content-bg) / 0.45);
          backdrop-filter: blur(1rem);
          -webkit-backdrop-filter: blur(1rem);
          box-shadow: 0 0 2.5rem -1rem rgba(0, 0, 0, 0.45);
          border-right: 1px solid rgb(var(--line) / 0.4);
          padding-top: calc(3.2rem + env(safe-area-inset-top));
          padding-right: 1.25rem;
          padding-left: 1.25rem;
          padding-bottom: 2rem;
        }
        body.menu-open #main-sidebar {
          transform: translateX(0);
          visibility: visible;
        }
        #main-sidebar .brand { display: none; }
        #main-sidebar nav { overflow-y: auto; }
        #main-sidebar .side-foot { padding-bottom: max(1rem, env(safe-area-inset-bottom)); }

        #drawer-backdrop {
          display: block;
          position: fixed;
          inset: 0;
          z-index: 25;
          background: rgb(0 0 0 / 0.4);
          opacity: 0;
          visibility: hidden;
          transition: opacity 0.25s ease-out, visibility 0.25s;
        }
        body.menu-open #drawer-backdrop {
          opacity: 1;
          visibility: visible;
        }
      }
      @media (max-width: 48rem) and (prefers-reduced-motion: reduce) {
        #main-sidebar, #drawer-backdrop { transition: none; }
        .hamb span { transition: none; }
      }

      /* 返回顶部按钮 */
      #back-to-top {
        position: fixed;
        right: 1.25rem;
        bottom: 1.5rem;
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 50%;
        border: 1px solid rgb(var(--line) / 0.5);
        background: rgb(var(--content-bg) / 0.5);
        backdrop-filter: blur(1rem);
        -webkit-backdrop-filter: blur(1rem);
        color: rgb(var(--text));
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        visibility: hidden;
        transform: translateY(0.5rem);
        transition: opacity 0.2s ease-out, transform 0.2s ease-out, visibility 0.2s;
        z-index: 30;
      }
      #back-to-top.visible { opacity: 1; visibility: visible; transform: translateY(0); }
      #back-to-top:hover { background: rgb(var(--content-bg) / 0.8); }
      #back-to-top svg { width: 1.1rem; height: 1.1rem; }
      @media (max-width: 48rem) {
        #back-to-top { right: 1rem; bottom: 1.25rem; width: 2.4rem; height: 2.4rem; }
      }

      /* 代码块复制按钮 */
      .prose pre { position: relative; }
      .prose pre .copy-btn {
        position: absolute;
        top: 0.4rem;
        right: 0.4rem;
        font-family: var(--font-ui);
        font-size: 0.7rem;
        padding: 0.2rem 0.55rem;
        border-radius: 5px;
        border: 1px solid rgb(var(--content-bg) / 0.3);
        background: rgb(var(--content-bg) / 0.15);
        color: rgb(var(--content-bg) / 0.8);
        cursor: pointer;
        opacity: 0;
        transition: opacity 0.15s ease-out, background 0.15s ease-out;
      }
      .prose pre:hover .copy-btn,
      .prose pre .copy-btn:focus-visible { opacity: 1; }
      .prose pre .copy-btn:hover { background: rgb(var(--content-bg) / 0.3); color: rgb(var(--content-bg)); }

      /* 外链角标 */
      .prose a .ext-icon {
        font-size: 0.78em;
        margin-left: 0.15em;
        vertical-align: super;
        color: rgb(var(--accent) / 0.8);
      }
    </style>
  </body>
