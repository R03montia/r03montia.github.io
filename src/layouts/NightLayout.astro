---
import '@fontsource/nixie-one';
import '@fontsource/outfit';
import '@fontsource/atkinson-hyperlegible';
import '../styles/global.css';
import Skyline from '../components/Skyline.astro';
import { ClientRouter } from 'astro:transitions';
import { INSIDE_AUTH_STORAGE_KEY, INSIDE_AUTH_TOKEN } from '../utils/inside-auth';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  hero?: boolean;
}
const {
  title,
  description = '下反熔毁集群 · 里版',
  ogImage = '/og.jpg',
  hero = false,
} = Astro.props;
// 里版 hero 背景图:之后你自己找张图放到 public/images/ 下,
// 然后把这一行的值改成对应路径(例如 '/images/night-hero.jpg')即可启用。
const heroBgImage = '/images/night-hero.jpg';
const heroHoverBgImage = '/images/night-hero-hover.webp';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
const insideAuthVars = {
  INSIDE_AUTH_STORAGE_KEY,
  INSIDE_AUTH_TOKEN,
};
---
<!doctype html>
<html lang="zh-CN" data-night data-theme="dark" data-rainy>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="下反熔毁集群" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#100f14" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <ClientRouter />
    <script is:inline define:vars={insideAuthVars}>
      (() => {
        const authorize = () => {
          try {
            if (localStorage.getItem(INSIDE_AUTH_STORAGE_KEY) === INSIDE_AUTH_TOKEN) {
              document.documentElement.setAttribute('data-inside-auth', 'ok');
              return;
            }
          } catch {
            /* localStorage 不可用时按未授权处理 */
          }

          const next = encodeURIComponent(
            location.pathname + location.search + location.hash,
          );
          location.replace(`/inside-gate/?next=${next}`);
        };

        authorize();
        document.addEventListener('astro:after-swap', authorize);

        // 交还访问权限：清除设备记忆后回到地表；下次下拉会重新经过密码门。
        document.addEventListener('click', (event) => {
          const target = event.target;
          if (!target?.closest?.('#inside-revoke-access')) return;
          try {
            localStorage.removeItem(INSIDE_AUTH_STORAGE_KEY);
          } catch {
            /* 隐私模式下忽略清除失败 */
          }
          document.documentElement.removeAttribute('data-inside-auth');
          window.location.replace('/');
        });
      })();
    </script>
    <style is:inline>
      html[data-night]:not([data-inside-auth='ok']) body {
        visibility: hidden !important;
      }
    </style>
  </head>
  <body>
    <header class="night-topbar">
      <a class="night-brand" href="/inside/">石 / 火 / 梦 / 身</a>
      <div class="night-search">
        <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
        <input id="site-search" type="search" placeholder="搜索里版内容…" aria-label="站内搜索" autocomplete="off" />
        <div id="search-results" role="listbox" aria-label="搜索结果"></div>
      </div>
      <button id="inside-revoke-access" class="night-revoke-link" type="button" title="交还访问权限">
        <span class="night-revoke-arrow" aria-hidden="true">↺</span>
        <span class="night-revoke-text">交还访问权限</span>
      </button>
      <a class="night-exit-link" href="/" aria-label="返回地表" title="返回地表">
        <span class="night-exit-arrow" aria-hidden="true">↑</span>
        <span class="night-exit-text">返回地表</span>
      </a>
    </header>
    <main
      id="main-content"
      class="night-main"
      class:list={[{ 'with-hero': hero }]}
      style={heroBgImage ? `--hero-bg-img: url(${heroBgImage}); --hero-hover-bg-img: url(${heroHoverBgImage})` : undefined}
    >
      {hero && (
        <section
          class="night-hero"
        >
          <div class="night-hero-hover-bg" aria-hidden="true"></div>
          <div class="night-hero-inner">
            <h1 class="night-hero-title">下反熔毁集群</h1>
            <p class="night-hero-sub">
              <span class="default">虽然我认为自己已从梦中苏醒，<br/>但我仍处于噩梦的正中心。</span>
              <span class="alt">我的灵魂是个哑巴<br/>从未和我的肉体说过话。</span>
            </p>
          </div>
          <div class="night-hero-hint" aria-hidden="true">
            <span class="hint-arrow">↓</span>
          </div>
        </section>
      )}
      {hero && <div class="night-transition" aria-hidden="true"></div>}
      <div class="night-body">
        {hero ? <slot name="below-hero" /> : <slot />}
      </div>
    </main>
    <div class="silhouettes" aria-hidden="true" transition:persist>
      <div class="sky-l2"><Skyline /></div>
      <div class="sky-l1"><Skyline /></div>
    </div>
    <div class="rain-overlay" aria-hidden="true" transition:persist></div>
    <script>
      // 从表版切到里版时,视口位置可能保留在表版的滚动位置,导致 hero 没出现在首屏。
      // 进入 /inside/* 任何页面都强制回到顶部。
      if (window.scrollY > 0) window.scrollTo(0, 0);
      document.addEventListener('astro:after-swap', () => {
        if (window.scrollY > 0 && !location.hash) window.scrollTo(0, 0);
      });

      // 站内搜索:与表版 BaseLayout 同一份 pagefind 客户端
      type PagefindResult = { data: () => Promise<{ url: string; excerpt: string; meta: { title?: string } }> };
      type Pagefind = { search: (q: string) => Promise<{ results: PagefindResult[] }> };
// 标题命中高亮：转义后把查询词包上主题色 mark。
const escHtml = (s: string): string =>
  s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] ?? c));
const highlightTitle = (title: string, q: string): string => {
  let h = escHtml(title);
  const words = Array.from(new Set(q.split(/\s+/).filter(Boolean))).sort((a, b) => b.length - a.length).slice(0, 5);
  for (const w of words) {
    const e = escHtml(w).replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    try { h = h.replace(new RegExp(`(${e})`, 'gi'), '<mark>$1</mark>'); } catch { /* 非法正则时跳过 */ }
  }
  return h;
};
      let pagefindPromise: Promise<Pagefind> | null = null;
      const loadPagefind = (): Promise<Pagefind> => {
        if (!pagefindPromise) {
          const dynamicImport = new Function('u', 'return import(u)') as (u: string) => Promise<unknown>;
          pagefindPromise = dynamicImport('/pagefind/pagefind.js') as Promise<Pagefind>;
        }
        return pagefindPromise;
      };
      const initSearch = () => {
        const input = document.getElementById('site-search') as HTMLInputElement | null;
        const panel = document.getElementById('search-results') as HTMLElement | null;
        if (!input || !panel) return;
        if ((input as HTMLInputElement & { __bound?: boolean }).__bound) return;
        (input as HTMLInputElement & { __bound?: boolean }).__bound = true;
        let timer: ReturnType<typeof setTimeout> | undefined;
        const close = () => { panel.classList.remove('open'); panel.innerHTML = ''; };
        input.addEventListener('input', () => {
          clearTimeout(timer);
          const q = input.value.trim();
          if (!q) { close(); return; }
          timer = setTimeout(async () => {
            try {
              const pf = await loadPagefind();
              const res = await pf.search(q);
              // 里版只展示 /inside/ 命名空间下的结果
              const items = (await Promise.all(res.results.map((r) => r.data())))
                .filter((d) => d.url.startsWith('/inside/'))
                .slice(0, 8);
              if (items.length === 0) {
                panel.innerHTML = '<div class="sr-empty">没有匹配的结果，换个关键词试试</div>';
              } else {
                panel.innerHTML = items
                  .map((d) => `<a href="${d.url}"><div class="sr-title">${highlightTitle(d.meta?.title ?? d.url, q)}</div></a>`)
                  .join('');
              }
              panel.classList.add('open');
            } catch {
              panel.innerHTML = '<div class="sr-empty">搜索索引未生成(需 npm run build)</div>';
              panel.classList.add('open');
            }
          }, 200);
        });
        input.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') { input.value = ''; close(); input.blur(); }
        });
        document.addEventListener('click', (e) => {
          if (!(e.target as Element | null)?.closest('.night-search')) close();
        });
        panel.addEventListener('click', (e) => {
          const a = (e.target as Element | null)?.closest('a');
          if (a) { input.value = ''; close(); }
        });
      };
      initSearch();
      document.addEventListener('astro:after-swap', initSearch);
    </script>
    <style is:global>
      /* ===== 里版布局:无侧栏,顶部极简横条 ===== */
      .night-topbar {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: 3rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0 1.25rem;
        z-index: 40;
        background: rgb(var(--content-bg) / 0.25);
        backdrop-filter: blur(1rem);
        -webkit-backdrop-filter: blur(1rem);
        border-bottom: 1px solid rgb(var(--line) / 0.3);
        /* 进入里版时从顶部滑入 */
        animation: topbar-slide-in 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.05s backwards;
      }
      @keyframes topbar-slide-in {
        from { transform: translateY(-100%); opacity: 0; }
        to   { transform: translateY(0);     opacity: 1; }
      }
      @media (prefers-reduced-motion: reduce) {
        .night-topbar { animation: none; }
      }
      .night-brand {
        font-family: var(--font-deco);
        font-size: 1rem;
        letter-spacing: 0.08em;
        color: rgb(var(--text));
        flex-shrink: 0;
      }
      .night-brand:hover { text-decoration: none; color: rgb(var(--accent)); }
      .night-search {
        flex: 1;
        max-width: 24rem;
        margin-left: auto;
        position: relative;
      }
      .night-search .search-icon {
        position: absolute;
        left: 0.75rem;
        top: 50%;
        transform: translateY(-50%);
        width: 0.9rem;
        height: 0.9rem;
        color: rgb(var(--text-secondary) / 0.8);
        pointer-events: none;
      }
      .night-search:focus-within .search-icon { color: rgb(var(--accent)); }
      .night-search #site-search {
        width: 100%;
        height: 2.25rem;
        padding: 0 0.9rem 0 2.1rem;
        font-family: var(--font-ui);
        font-size: 0.85rem;
        color: rgb(var(--text));
        background: rgb(var(--content-bg) / 0.4);
        border: 1px solid rgb(var(--line) / 0.4);
        border-radius: 999px;
        outline: none;
        transition: border-color 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
      }
      .night-search #site-search::placeholder { color: rgb(var(--text-secondary) / 0.7); }
      .night-search #site-search:focus {
        border-color: rgb(var(--accent) / 0.8);
        background: rgb(var(--content-bg) / 0.6);
        box-shadow: 0 0 0 3px rgb(var(--accent) / 0.15);
      }
      .night-search #site-search::-webkit-search-cancel-button { cursor: pointer; }
      .night-search #search-results {
        position: absolute;
        top: calc(100% + 0.4rem);
        left: 0;
        right: 0;
        max-height: 60vh;
        overflow-y: auto;
        border-radius: 14px;
        padding: 0.4rem;
        background: rgb(var(--content-bg) / 0.92);
        backdrop-filter: blur(1rem);
        -webkit-backdrop-filter: blur(1rem);
        border: 1px solid rgb(var(--line) / 0.5);
        box-shadow: 0 16px 40px -12px rgba(0, 0, 0, 0.5);
        display: none;
        z-index: 50;
      }
      .night-search #search-results.open {
        display: block;
        animation: sr-pop 0.16s ease-out;
      }
      @keyframes sr-pop {
        from { opacity: 0; transform: translateY(-4px) scale(0.99); }
        to { opacity: 1; transform: none; }
      }
      .night-search #search-results a {
        position: relative;
        display: block;
        padding: 0.55rem 0.7rem 0.55rem 0.9rem;
        border-radius: 10px;
        color: rgb(var(--text));
        overflow: hidden;
        transition: background 0.15s ease;
      }
      .night-search #search-results a + a { margin-top: 2px; }
      .night-search #search-results a::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0.5rem;
        bottom: 0.5rem;
        width: 3px;
        border-radius: 99px;
        background: rgb(var(--accent));
        opacity: 0;
        transform: scaleY(0.6);
        transition: opacity 0.15s ease, transform 0.15s ease;
      }
      .night-search #search-results a:hover {
        background: rgb(var(--accent) / 0.12);
        text-decoration: none;
      }
      .night-search #search-results a:hover::before { opacity: 1; transform: none; }
      .night-search .sr-title {
        font-family: var(--font-ui);
        font-size: 0.88rem;
        font-weight: 650;
        display: block;
        line-height: 1.4;
      }
      .night-search .sr-title::after {
        content: "\2197";
        float: right;
        margin-left: 0.4rem;
        font-size: 0.75rem;
        color: rgb(var(--text-secondary));
        opacity: 0;
        transition: opacity 0.15s ease;
      }
      .night-search #search-results a:hover .sr-title::after { opacity: 0.8; }
      .night-search .sr-excerpt {
        font-size: 0.74rem;
        color: rgb(var(--text-secondary));
        margin-top: 0.15rem;
        line-height: 1.45;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .night-search #search-results mark {
        background: rgb(var(--accent) / 0.25);
        color: inherit;
        font-weight: 600;
        border-radius: 4px;
        padding: 0 2px;
      }
      .night-search .sr-empty {
        padding: 1rem 0.8rem;
        font-size: 0.78rem;
        text-align: center;
        color: rgb(var(--text-secondary));
      }

      .night-exit-link:hover {
        background: rgb(var(--content-bg) / 0.6);
        text-decoration: none;
        transform: translateY(-1px);
      }
      .night-exit-link .night-exit-arrow {
        color: rgb(var(--text));
        font-size: 0.95rem;
        line-height: 1;
      }

      .night-revoke-link {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.3rem 0.7rem;
        border-radius: 999px;
        border: 1px solid rgb(var(--line) / 0.4);
        background: rgb(var(--content-bg) / 0.3);
        color: rgb(var(--text));
        font-family: var(--font-ui);
        font-size: 0.82rem;
        flex-shrink: 0;
        cursor: pointer;
        transition: background 0.15s ease-out, transform 0.15s ease-out;
      }
      .night-revoke-link:hover {
        background: rgb(var(--content-bg) / 0.6);
        transform: translateY(-1px);
      }
      .night-revoke-link .night-revoke-arrow {
        color: rgb(var(--text));
        font-size: 0.95rem;
        line-height: 1;
      }
      @media (max-width: 34rem) {
        .night-revoke-link .night-revoke-text { display: none; }
      }

      /* 内容主体:居中,无侧栏 */
      .night-main {
        position: relative;
        z-index: 2;
        width: 100%;
        max-width: 46rem;
        margin: 0 auto;
        padding: calc(3rem + 2.5rem) 1.5rem calc(5rem + env(safe-area-inset-bottom));
      }
      /* hero 模式下:main 取消最大宽度与上边距,hero 区独占 100vh,下方内容区再加容器 */
      .night-main.with-hero {
        max-width: none;
        padding: 0;
      }
      .night-main.with-hero .night-body {
        max-width: 46rem;
        margin: 0 auto;
        padding: 2.5rem 1.5rem calc(5rem + env(safe-area-inset-bottom));
      }
      .night-main:not(.with-hero) .night-body {
        /* 非 hero 页 night-body 是直通容器,无样式 */
      }

      /* 里版 hero:100vh 全屏,大标题居中,底部"↓"提示下滚 */
      .night-hero {
        position: relative;
        height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        overflow: hidden;
        background-color: transparent;
        background-image:
          radial-gradient(ellipse 80% 50% at 50% 30%, rgb(60 70 110 / 0.45), transparent 70%);
      }
      /* hero 背景固定在视口,但只透过 hero 区域显示;这样下方正文仍是原来的夜色渐变 */
      .night-hero::before {
        content: '';
        position: absolute;
        inset: -10%;
        background-image: var(--hero-bg-img, none);
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        z-index: 0;
        pointer-events: none;
      }
      /* 轻微暗化蒙版,保证标题可读,但不再遮挡固定背景 */
      .night-hero::after {
        content: '';
        position: absolute;
        inset: 0;
        /* 头图暗化 + 头图 → 原里版正文的过渡层:底部淡出到夜色底色,但正文背景仍保持原样 */
        background: linear-gradient(
          to bottom,
          rgb(var(--body-bg) / 0.55) 0%,
          rgb(var(--body-bg) / 0.7) 55%,
          rgb(var(--body-bg) / 0.75) 100%
        );
        z-index: 1;
        pointer-events: none;
      }
      .night-transition {
        position: relative;
        height: clamp(7rem, 18vh, 11rem);
        overflow: hidden;
        pointer-events: none;
      }
      .night-transition::before {
        content: '';
        position: absolute;
        inset: 0;
        background-image: var(--hero-bg-img, none);
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        z-index: 0;
      }
      .night-transition::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(
          to bottom,
          rgb(var(--body-bg) / 0.75) 0%,
          rgb(var(--body-bg) / 0.88) 60%,
          rgb(var(--body-bg)) 100%
        );
        z-index: 1;
      }
      .night-hero-inner {
        position: relative;
        z-index: 2;
        padding: 0 1.5rem;
      }
      .night-hero-hover-bg {
        position: absolute;
        inset: -10%;
        background-image: var(--hero-hover-bg-img, var(--hero-bg-img, none));
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        z-index: 0;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.6s ease;
        will-change: opacity;
      }
      .night-hero:has(.night-hero-title:hover) .night-hero-hover-bg {
        opacity: 1;
      }
      .night-hero-title {
        display: inline-block;
        max-width: 100%;
        margin: 0;
        font-family: var(--font-deco);
        font-weight: 400;
        font-size: clamp(3rem, 9vw, 5.5rem);
        letter-spacing: 0.04em;
        line-height: 1.15;
        background: linear-gradient(135deg, rgb(220 228 252), rgb(120 140 255));
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        text-shadow: 0 0 60px rgb(120 140 255 / 0.25);
        opacity: 0;
        transform: translateY(1.2rem);
        filter: blur(8px);
        animation: hero-rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.15s forwards;
      }
      .night-hero-sub {
        margin: 1.5rem 0 0;
        display: grid;
        justify-items: center;
        font-size: clamp(0.95rem, 2.2vw, 1.15rem);
        color: rgb(var(--text));
        line-height: 1.8;
        letter-spacing: 0.08em;
        text-shadow: 0 0 3px black, 0 0 8px black;
        opacity: 0;
        transform: translateY(0.8rem);
        filter: blur(6px);
        animation: hero-rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.55s forwards;
      }
      .night-hero-sub > span {
        grid-area: 1 / 1;
        opacity: 0;
        transition: opacity 0.6s ease;
      }
      .night-hero-sub > .default {
        opacity: 1;
      }
      .night-hero:has(.night-hero-title:hover) .night-hero-sub > .default {
        opacity: 0;
      }
      .night-hero:has(.night-hero-title:hover) .night-hero-sub > .alt {
        opacity: 1;
      }
      /* 标题/副标题共用浮现动画:上浮 + 褪模糊 + 渐入 */
      @keyframes hero-rise {
        to { opacity: 1; transform: translateY(0); filter: blur(0); }
      }
      /* 标题呼吸:浮现完成后,文字光晕缓慢一明一暗 */
      .night-hero-title {
        animation:
          hero-rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.15s forwards,
          hero-breathe 5s ease-in-out 1.2s infinite;
      }
      @keyframes hero-breathe {
        0%, 100% { text-shadow: 0 0 60px rgb(120 140 255 / 0.22); }
        50%      { text-shadow: 0 0 80px rgb(120 140 255 / 0.45); }
      }
      .night-hero-hint {
        position: absolute;
        bottom: 2.5rem;
        left: 50%;
        transform: translateX(-50%);
        color: rgb(var(--text-secondary));
        font-size: 1.4rem;
        opacity: 0;
        animation:
          hint-fade-in 0.6s ease-out 1.4s forwards,
          hero-hint-bob 2.2s ease-in-out 2s infinite;
      }
      @keyframes hint-fade-in {
        to { opacity: 0.7; }
      }
      @keyframes hero-hint-bob {
        0%, 100% { transform: translate(-50%, 0); }
        50%      { transform: translate(-50%, 0.5rem); }
      }
      @media (prefers-reduced-motion: reduce) {
        .night-hero-title,
        .night-hero-sub,
        .night-hero-hint {
          animation: none !important;
          opacity: 1 !important;
          transform: none !important;
          filter: none !important;
        }
        .night-hero-sub > span {
          transition: none !important;
        }
        .night-hero-hover-bg {
          transition: none !important;
        }
        .night-hero-hint { opacity: 0.7 !important; }
      }

      /* 里版隐藏表版的明暗切换按钮相关(此 layout 本就不渲染那些按钮) */

      @media (max-width: 48rem) {
        .night-topbar { padding: 0 0.85rem; gap: 0.6rem; }
        .night-brand { font-size: 0.9rem; }
        .night-search { max-width: none; }
        .night-exit-link .night-exit-text { display: none; }
        .night-exit-link { padding: 0.3rem 0.5rem; }
      }
    </style>
  </body>
