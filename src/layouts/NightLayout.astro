---
import '@fontsource/nixie-one';
import '@fontsource/outfit';
import '@fontsource/atkinson-hyperlegible';
import '../styles/global.css';
import Skyline from '../components/Skyline.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  hero?: boolean;
}
const {
  title,
  description = '下反熔毁集群 · 里版',
  ogImage = '/og.jpg',
  hero = false,
} = Astro.props;
// 里版 hero 背景图:之后你自己找张图放到 public/images/ 下,
// 然后把这一行的值改成对应路径(例如 '/images/night-hero.jpg')即可启用。
const heroBgImage = '/images/night-hero.jpg';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
---
<!doctype html>
<html lang="zh-CN" data-night data-theme="dark" data-rainy>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="下反熔毁集群" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#100f14" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <header class="night-topbar">
      <a class="night-brand" href="/inside/">石 / 火 / 梦 / 身</a>
      <div class="night-search">
        <input id="site-search" type="search" placeholder="搜索…" aria-label="站内搜索" autocomplete="off" />
        <div id="search-results" role="listbox" aria-label="搜索结果"></div>
      </div>
      <a class="night-exit-link" href="/" aria-label="返回地表" title="返回地表">
        <span class="night-exit-arrow" aria-hidden="true">↑</span>
        <span class="night-exit-text">返回地表</span>
      </a>
    </header>
    <main id="main-content" class="night-main" class:list={[{ 'with-hero': hero }]}>
      {hero && (
        <section class="night-hero" style={heroBgImage ? `--hero-bg-img: url(${heroBgImage})` : undefined}>
          <div class="night-hero-inner">
            <h1 class="night-hero-title">下反熔毁集群</h1>
            <p class="night-hero-sub">虽然我认为自己已从梦中苏醒，<br/>但我仍处于噩梦的正中心。</p>
          </div>
          <div class="night-hero-hint" aria-hidden="true">
            <span class="hint-arrow">↓</span>
          </div>
        </section>
      )}
      <div class="night-body">
        {hero ? <slot name="below-hero" /> : <slot />}
      </div>
    </main>
    <div class="silhouettes" aria-hidden="true" transition:persist>
      <div class="sky-l2"><Skyline /></div>
      <div class="sky-l1"><Skyline /></div>
    </div>
    <div class="rain-overlay" aria-hidden="true" transition:persist></div>
    <script>
      // 从表版切到里版时,视口位置可能保留在表版的滚动位置,导致 hero 没出现在首屏。
      // 进入 /inside/* 任何页面都强制回到顶部。
      if (window.scrollY > 0) window.scrollTo(0, 0);
      document.addEventListener('astro:after-swap', () => {
        if (window.scrollY > 0 && !location.hash) window.scrollTo(0, 0);
      });

      // 站内搜索:与表版 BaseLayout 同一份 pagefind 客户端
      type PagefindResult = { data: () => Promise<{ url: string; excerpt: string; meta: { title?: string } }> };
      type Pagefind = { search: (q: string) => Promise<{ results: PagefindResult[] }> };
      let pagefindPromise: Promise<Pagefind> | null = null;
      const loadPagefind = (): Promise<Pagefind> => {
        if (!pagefindPromise) {
          const dynamicImport = new Function('u', 'return import(u)') as (u: string) => Promise<unknown>;
          pagefindPromise = dynamicImport('/pagefind/pagefind.js') as Promise<Pagefind>;
        }
        return pagefindPromise;
      };
      const initSearch = () => {
        const input = document.getElementById('site-search') as HTMLInputElement | null;
        const panel = document.getElementById('search-results') as HTMLElement | null;
        if (!input || !panel) return;
        if ((input as HTMLInputElement & { __bound?: boolean }).__bound) return;
        (input as HTMLInputElement & { __bound?: boolean }).__bound = true;
        let timer: ReturnType<typeof setTimeout> | undefined;
        const close = () => { panel.classList.remove('open'); panel.innerHTML = ''; };
        input.addEventListener('input', () => {
          clearTimeout(timer);
          const q = input.value.trim();
          if (!q) { close(); return; }
          timer = setTimeout(async () => {
            try {
              const pf = await loadPagefind();
              const res = await pf.search(q);
              // 里版只展示 /inside/ 命名空间下的结果
              const items = (await Promise.all(res.results.map((r) => r.data())))
                .filter((d) => d.url.startsWith('/inside/'))
                .slice(0, 8);
              if (items.length === 0) {
                panel.innerHTML = '<div class="sr-empty">没有匹配的结果</div>';
              } else {
                panel.innerHTML = items
                  .map((d) => `<a href="${d.url}"><div class="sr-title">${d.meta?.title ?? d.url}</div><div class="sr-excerpt">${d.excerpt}</div></a>`)
                  .join('');
              }
              panel.classList.add('open');
            } catch {
              panel.innerHTML = '<div class="sr-empty">搜索索引未生成(需 npm run build)</div>';
              panel.classList.add('open');
            }
          }, 200);
        });
        input.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') { input.value = ''; close(); input.blur(); }
        });
        document.addEventListener('click', (e) => {
          if (!(e.target as Element | null)?.closest('.night-search')) close();
        });
        panel.addEventListener('click', (e) => {
          const a = (e.target as Element | null)?.closest('a');
          if (a) { input.value = ''; close(); }
        });
      };
      initSearch();
      document.addEventListener('astro:after-swap', initSearch);
    </script>
    <style is:global>
      /* ===== 里版布局:无侧栏,顶部极简横条 ===== */
      .night-topbar {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: 3rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0 1.25rem;
        z-index: 40;
        background: rgb(var(--content-bg) / 0.25);
        backdrop-filter: blur(1rem);
        -webkit-backdrop-filter: blur(1rem);
        border-bottom: 1px solid rgb(var(--line) / 0.3);
      }
      .night-brand {
        font-family: var(--font-deco);
        font-size: 1rem;
        letter-spacing: 0.08em;
        color: rgb(var(--text));
        flex-shrink: 0;
      }
      .night-brand:hover { text-decoration: none; color: rgb(var(--accent)); }
      .night-search {
        flex: 1;
        max-width: 24rem;
        margin-left: auto;
        position: relative;
      }
      .night-search #site-search {
        width: 100%;
        padding: 0.35rem 0.65rem;
        font-family: var(--font-ui);
        font-size: 0.85rem;
        color: rgb(var(--text));
        background: rgb(var(--content-bg) / 0.4);
        border: 1px solid rgb(var(--line) / 0.4);
        border-radius: 999px;
        outline: none;
      }
      .night-search #site-search:focus {
        border-color: rgb(var(--accent) / 0.7);
        background: rgb(var(--content-bg) / 0.6);
      }
      .night-search #search-results {
        position: absolute;
        top: calc(100% + 0.4rem);
        left: 0;
        right: 0;
        max-height: 60vh;
        overflow-y: auto;
        border-radius: 8px;
        background: rgb(var(--content-bg) / 0.85);
        backdrop-filter: blur(1rem);
        -webkit-backdrop-filter: blur(1rem);
        border: 1px solid rgb(var(--line) / 0.5);
        box-shadow: 0 8px 24px -8px rgba(0, 0, 0, 0.5);
        display: none;
        z-index: 50;
      }
      .night-search #search-results.open { display: block; }
      .night-search #search-results a {
        display: block;
        padding: 0.55rem 0.8rem;
        color: rgb(var(--text));
        border-bottom: 1px solid rgb(var(--line) / 0.3);
      }
      .night-search #search-results a:last-child { border-bottom: none; }
      .night-search #search-results a:hover {
        background: rgb(var(--content-bg) / 0.7);
        text-decoration: none;
      }
      .night-search .sr-title { font-family: var(--font-ui); font-size: 0.88rem; }
      .night-search .sr-excerpt {
        font-size: 0.74rem;
        color: rgb(var(--text-secondary));
        margin-top: 0.15rem;
        line-height: 1.45;
      }
      .night-search .sr-excerpt mark {
        background: rgb(var(--accent) / 0.3);
        color: inherit;
        border-radius: 2px;
        padding: 0 1px;
      }
      .night-search .sr-empty {
        padding: 0.6rem 0.8rem;
        font-size: 0.78rem;
        color: rgb(var(--text-secondary));
      }

      /* 返回地表:顶栏右侧,横向排 */
      .night-exit-link {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.3rem 0.7rem;
        border-radius: 999px;
        border: 1px solid rgb(var(--line) / 0.4);
        background: rgb(var(--content-bg) / 0.3);
        color: rgb(var(--text));
        font-family: var(--font-ui);
        font-size: 0.82rem;
        flex-shrink: 0;
        transition: background 0.15s ease-out, transform 0.15s ease-out;
      }
      .night-exit-link:hover {
        background: rgb(var(--content-bg) / 0.6);
        text-decoration: none;
        transform: translateY(-1px);
      }
      .night-exit-link .night-exit-arrow {
        color: rgb(var(--text));
        font-size: 0.95rem;
        line-height: 1;
      }

      /* 内容主体:居中,无侧栏 */
      .night-main {
        position: relative;
        z-index: 2;
        width: 100%;
        max-width: 46rem;
        margin: 0 auto;
        padding: calc(3rem + 2.5rem) 1.5rem calc(5rem + env(safe-area-inset-bottom));
      }
      /* hero 模式下:main 取消最大宽度与上边距,hero 区独占 100vh,下方内容区再加容器 */
      .night-main.with-hero {
        max-width: none;
        padding: 0;
      }
      .night-main.with-hero .night-body {
        max-width: 46rem;
        margin: 0 auto;
        padding: 2.5rem 1.5rem calc(5rem + env(safe-area-inset-bottom));
      }
      .night-main:not(.with-hero) .night-body {
        /* 非 hero 页 night-body 是直通容器,无样式 */
      }

      /* 里版 hero:100vh 全屏,大标题居中,底部"↓"提示下滚 */
      .night-hero {
        position: relative;
        height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        overflow: hidden;
        /* 底色先兜一层实色,防止图片/渐变未加载时透出页面底 */
        background-color: rgb(var(--body-bg));
        /* 预留:--hero-bg-img 由组件 props 传入;空时只有渐变,有值时渐变叠在图上 */
        background-image:
          linear-gradient(to bottom, rgb(var(--body-bg) / 0.55), rgb(var(--body-bg) / 0.85)),
          var(--hero-bg-img, none),
          radial-gradient(ellipse 80% 50% at 50% 30%, rgb(60 70 110 / 0.45), transparent 70%);
        background-size: cover, cover, cover;
        background-position: center, center, center;
        background-repeat: no-repeat;
      }
      .night-hero-inner {
        position: relative;
        z-index: 2;
        padding: 0 1.5rem;
      }
      .night-hero-title {
        margin: 0;
        font-family: var(--font-deco);
        font-weight: 400;
        font-size: clamp(3rem, 9vw, 5.5rem);
        letter-spacing: 0.04em;
        line-height: 1.15;
        background: linear-gradient(135deg, rgb(220 228 252), rgb(120 140 255));
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        text-shadow: 0 0 60px rgb(120 140 255 / 0.25);
      }
      .night-hero-sub {
        margin: 1.5rem 0 0;
        font-size: clamp(0.95rem, 2.2vw, 1.15rem);
        color: rgb(var(--text));
        line-height: 1.8;
        letter-spacing: 0.08em;
        text-shadow: 0 0 3px black, 0 0 8px black;
      }
      .night-hero-hint {
        position: absolute;
        bottom: 2.5rem;
        left: 50%;
        transform: translateX(-50%);
        color: rgb(var(--text-secondary));
        font-size: 1.4rem;
        animation: hero-hint-bob 2.2s ease-in-out infinite;
      }
      @keyframes hero-hint-bob {
        0%, 100% { transform: translate(-50%, 0); opacity: 0.6; }
        50%      { transform: translate(-50%, 0.5rem); opacity: 1; }
      }
      @media (prefers-reduced-motion: reduce) {
        .night-hero-hint { animation: none; }
      }

      /* 里版隐藏表版的明暗切换按钮相关(此 layout 本就不渲染那些按钮) */

      @media (max-width: 48rem) {
        .night-topbar { padding: 0 0.85rem; gap: 0.6rem; }
        .night-brand { font-size: 0.9rem; }
        .night-search { max-width: none; }
        .night-exit-link .night-exit-text { display: none; }
        .night-exit-link { padding: 0.3rem 0.5rem; }
      }
    </style>
  </body>
</html>
