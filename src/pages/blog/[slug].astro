---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getRelatedPosts, readingTime, sortPosts } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = sortPosts(await getCollection('blog', (p) => !p.data.night && !p.data.draft));
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      prev: i > 0 ? posts[i - 1] : null,          // 较新一篇
      next: i < posts.length - 1 ? posts[i + 1] : null, // 较旧一篇
      relatedPosts: getRelatedPosts(post, posts),
    },
  }));
}

const { post, prev, next, relatedPosts } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const fmt = new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
---
<BaseLayout title={`${post.data.title} | R03montia`} description={post.data.description} ogImage={post.data.cover} ogType="article">
  <div class="progress-bar" aria-hidden="true"><span class="progress-fill"></span></div>
  <div class="post-layout">
    {toc.length > 1 && (
      <aside class="toc card">
        <div class="toc-title">目录</div>
        <ul>
          {toc.map((h) => (
            <li class:list={[`d${h.depth}`]}><a href={`#${h.slug}`} data-toc-link={h.slug}>{h.text}</a></li>
          ))}
        </ul>
      </aside>
    )}
    <article class="post-card card post">
    <header>
      <h1>{post.data.title}</h1>
      <div class="meta">
        <time datetime={post.data.date.toISOString()}>{fmt.format(post.data.date)}</time>
        {post.data.updated && (
          <span>
            更新于
            <time datetime={post.data.updated.toISOString()}>{fmt.format(post.data.updated)}</time>
          </span>
        )}
        <span>约 {readingTime(post.body ?? '')} 分钟</span>
        {post.data.tags.map((t) => <a href={`/tag/${t}/`}>#{t}</a>)}
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
    {(prev || next) && (
      <nav class="post-nav" aria-label="文章导航">
        {prev ? (
          <a class="post-nav-link prev" href={`/blog/${prev.id}/`}>
            <span class="post-nav-dir">← 上一篇</span>
            <span class="post-nav-title">{prev.data.title}</span>
          </a>
        ) : <span />}
        {next ? (
          <a class="post-nav-link next" href={`/blog/${next.id}/`}>
            <span class="post-nav-dir">下一篇 →</span>
            <span class="post-nav-title">{next.data.title}</span>
          </a>
        ) : <span />}
      </nav>
    )}

    {relatedPosts.length > 0 && (
      <section class="related-posts" aria-labelledby="related-posts-title">
        <h2 id="related-posts-title">相关阅读</h2>
        <div class="related-grid">
          {relatedPosts.map((related) => (
            <a class="related-card" href={`/blog/${related.id}/`}>
              <span class="related-title">{related.data.title}</span>
              <span class="related-desc">{related.data.description}</span>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
  </div>
</BaseLayout>

<script>
  // 阅读进度 + TOC 滚动监听。Astro 切页时模块脚本会重跑,需要在 cleanup 时
  // 移除监听,否则会叠加。
  const fill = document.querySelector<HTMLElement>('.progress-fill');
  const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
  const headingsEls = tocLinks
    .map((a) => document.getElementById(a.dataset.tocLink || ''))
    .filter((el): el is HTMLElement => !!el);

  const onScroll = () => {
    if (fill) {
      const doc = document.documentElement;
      const total = doc.scrollHeight - doc.clientHeight;
      const pct = total > 0 ? Math.min(1, doc.scrollTop / total) : 0;
      fill.style.transform = `scaleX(${pct})`;
    }
    if (headingsEls.length > 0) {
      const fromTop = window.scrollY + 96; // 给 header 留一点提前量
      let activeIdx = -1;
      for (let i = 0; i < headingsEls.length; i++) {
        if (headingsEls[i].offsetTop <= fromTop) activeIdx = i;
        else break;
      }
      tocLinks.forEach((a, i) => a.classList.toggle('active', i === activeIdx));
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
  document.addEventListener('astro:before-swap', () => {
    window.removeEventListener('scroll', onScroll);
  }, { once: true });
</script>

<style>
  .post-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 12rem;
    gap: 1.25rem;
    align-items: start;
    /* 保持 main/文章框与首页对齐，只把目录延伸进右侧既有空白区。 */
    width: calc(100% + 13.25rem);
    margin-right: -13.25rem;
  }
  .post {
    grid-column: 1;
    grid-row: 1;
    border-radius: 12px;
    padding: 2rem clamp(1.2rem, 4vw, 2.5rem);
    margin-bottom: 4rem;
  }
  h1 { font-family: var(--font-ui); line-height: 1.3; }
  .meta { display: flex; flex-wrap: wrap; gap: 1rem; font-size: 0.82rem; color: rgb(var(--text-secondary)); margin-bottom: 1.5rem; }
  .toc {
    grid-column: 2;
    grid-row: 1;
    position: sticky;
    top: 6rem;
    border-radius: 10px;
    width: 12rem;
    padding: 0.8rem 1rem;
    font-size: 0.78rem;
    max-height: calc(100vh - 8rem);
    overflow-y: auto;
  }
  .toc-title { font-family: var(--font-ui); margin-bottom: 0.4rem; color: rgb(var(--text-secondary)); }
  .toc ul { list-style: none; margin: 0; padding: 0; }
  .toc li.d3 { padding-left: 0.9rem; }
  .toc a { color: rgb(var(--text-secondary)); display: block; padding: 0.1rem 0; border-left: 2px solid transparent; padding-left: 0.5rem; margin-left: -0.5rem; }
  .toc a.active { color: rgb(var(--accent)); border-left-color: rgb(var(--accent)); }
  .prose :global(h2) { font-family: var(--font-ui); border-bottom: 1px solid rgb(var(--line) / 0.4); padding-bottom: 0.3rem; scroll-margin-top: 2rem; }
  .prose :global(h3) { font-family: var(--font-ui); scroll-margin-top: 2rem; }
  .prose :global(blockquote) { margin: 1rem 0; padding: 0.2rem 1rem; border-left: 0.3rem solid rgb(var(--accent) / 0.7); background: rgb(var(--content-bg) / 0.6); }
  .prose :global(code) { background: rgb(var(--text) / 0.08); padding: 0.1rem 0.35rem; border-radius: 4px; font-size: 0.88em; }
  .prose :global(pre) { background: rgb(var(--text) / 0.92); color: rgb(var(--content-bg)); padding: 1rem 1.2rem; border-radius: 8px; overflow-x: auto; }
  .prose :global(pre code) { background: none; color: inherit; padding: 0; }
  .prose :global(img) { max-width: 100%; filter: grayscale(1); transition: filter 0.3s ease; }
  .prose :global(img:hover) { filter: grayscale(0); }
  /* 右侧空白区要能完整放下目录时才显示 */
  @media (max-width: 80rem) {
    .post-layout {
      display: block;
      width: auto;
      margin-right: 0;
    }
    .toc { display: none; }
  }

  /* 阅读进度条:固定视口顶,移动端在 mobile-topbar 下 */
  .progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    z-index: 50;
    background: transparent;
    pointer-events: none;
  }
  .progress-fill {
    display: block;
    height: 100%;
    width: 100%;
    background: rgb(var(--accent));
    transform-origin: 0 50%;
    transform: scaleX(0);
    transition: transform 0.06s linear;
  }
  @media (max-width: 48rem) {
    .progress-bar { top: 3.2rem; }
  }

  /* 上一篇 / 下一篇 */
  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(var(--line) / 0.4);
  }
  .post-nav-link {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.6rem 0.85rem;
    border-radius: 8px;
    color: rgb(var(--text));
    border: 1px solid rgb(var(--line) / 0.4);
    background: rgb(var(--content-bg) / 0.25);
  }
  .post-nav-link:hover { text-decoration: none; background: rgb(var(--content-bg) / 0.6); }
  .post-nav-link.next { text-align: right; align-items: flex-end; }
  .post-nav-dir { font-size: 0.72rem; color: rgb(var(--text-secondary)); font-family: var(--font-ui); }
  .post-nav-title { font-size: 0.86rem; font-family: var(--font-ui); }

  /* 相关阅读:按共享标签数推荐 */
  .related-posts { margin-top: 2rem; }
  .related-posts h2 {
    font-family: var(--font-ui);
    font-size: 1rem;
    margin: 0 0 0.9rem;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .related-card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.85rem;
    border: 1px solid rgb(var(--line) / 0.4);
    border-radius: 8px;
    background: rgb(var(--content-bg) / 0.25);
    color: inherit;
  }
  .related-card:hover { text-decoration: none; background: rgb(var(--content-bg) / 0.6); }
  .related-title {
    font-family: var(--font-ui);
    font-size: 0.88rem;
    line-height: 1.35;
  }
  .related-desc {
    color: rgb(var(--text-secondary));
    font-size: 0.78rem;
    line-height: 1.45;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }
  @media (max-width: 48rem) {
    .post-nav { grid-template-columns: 1fr; }
    .post-nav-link.next { text-align: left; align-items: flex-start; }
    .related-grid { grid-template-columns: 1fr; }
  }
</style>
