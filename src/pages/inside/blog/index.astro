---
import { getCollection } from 'astro:content';
import NightLayout from '../../../layouts/NightLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { sortListedPosts } from '../../../utils/posts';

const posts = sortListedPosts(await getCollection('blog', (p) => p.data.night && !p.data.draft));
const allTags = [...new Set(posts.flatMap((p) => p.data.tags))];
---
<NightLayout title="夜里 · 下反熔毁集群" description="里版全部文章。">
  <h1 class="page-title">最近更新</h1>
  {allTags.length > 0 && (
    <div class="tag-row">
      {allTags.map((t) => <a class="tag-pill" href={`/inside/tag/${t}/`}>#{t}</a>)}
    </div>
  )}
  {posts.length === 0 ? (
    <p class="empty">夜里还没有文章。等下一场梦。</p>
  ) : (
    <div class="post-list">
      {posts.map((p) => <PostCard post={p} night />)}
    </div>
  )}
</NightLayout>

<style>
  .page-title { font-family: var(--font-ui); }
  .tag-row { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0 0 1.5rem; }
  .tag-pill {
    font-size: 0.8rem;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    border: 1px solid rgb(var(--line) / 0.5);
    color: rgb(var(--text-secondary));
  }
  .post-list { display: grid; gap: 0.9rem; }
  .empty { color: rgb(var(--text-secondary)); font-size: 0.9rem; padding: 1rem 0; }
</style>
