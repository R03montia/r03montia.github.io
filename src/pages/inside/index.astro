---
import { getCollection } from 'astro:content';
import NightLayout from '../../layouts/NightLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { sortPosts } from '../../utils/posts';

const all = sortPosts(await getCollection('blog'));
const nightPosts = all.filter((p) => p.data.night);
---
<NightLayout title="石 / 火 / 梦 / 身" description="下反熔毁集群 · 里版" hero>
  <section class="recent" slot="below-hero">
    <h2>夜里的更新</h2>
    {nightPosts.length === 0 ? (
      <p class="empty">夜里还没有文章。等下一场梦。</p>
    ) : (
      <div class="list">
        {nightPosts.map((p) => <PostCard post={p} night />)}
      </div>
    )}
    {nightPosts.length > 0 && <a class="more" href="/inside/blog/">浏览全部 →</a>}
  </section>
</NightLayout>

<style>
  .recent h2 { font-family: var(--font-ui); font-size: 1.1rem; }
  .list { display: grid; gap: 0.9rem; }
  .more { display: inline-block; margin-top: 1rem; font-family: var(--font-ui); font-size: 0.9rem; }
  .empty { color: rgb(var(--text-secondary)); font-size: 0.9rem; padding: 1rem 0; }
</style>

