---
import { getCollection } from 'astro:content';
import NightLayout from '../../../layouts/NightLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { sortPosts } from '../../../utils/posts';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (p) => p.data.night && !p.data.draft);
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({ params: { tag } }));
}

const { tag } = Astro.params;
const posts = sortPosts(await getCollection('blog', (p) => p.data.night && !p.data.draft && p.data.tags.includes(tag!)));
---
<NightLayout title={`#${tag} | 下反熔毁集群`} description={`里版标签 #${tag} 下的全部文章。`}>
  <h1 class="page-title">#{tag}</h1>
  <p><a href="/inside/blog/">← 返回夜里全部文章</a></p>
  <div class="post-list">
    {posts.map((p) => <PostCard post={p} night />)}
  </div>
</NightLayout>

<style>
  .page-title { font-family: var(--font-ui); }
  .post-list { display: grid; gap: 0.9rem; }
</style>
