---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="挂机 | R03montia"
  description="R03montia 的挂机页面：大字时钟、身份与天气。"
  idle
>
  <section id="idle-stage" class="idle-stage" aria-label="挂机模式">
    <div class="idle-top">
      <div class="idle-actions">
        <button id="theme-toggle" class="idle-action" type="button" aria-label="切换明暗模式" title="切换明暗模式">
          <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"/>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
          </svg>
          <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </button>
        <button id="rain-toggle" class="idle-action" type="button" aria-label="切换下雨效果" title="切换下雨效果">
          <svg class="icon-rain" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242"/>
            <path d="M16 14v6"/><path d="M8 14v6"/><path d="M12 16v6"/>
          </svg>
          <svg class="icon-rain-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M2 2l20 20"/>
            <path d="M5.782 5.782A7 7 0 0 0 9 19h8.5a4.5 4.5 0 0 0 1.307-.193"/>
            <path d="M21.532 16.5A4.5 4.5 0 0 0 17.5 10h-1.79A7.008 7.008 0 0 0 10 5.07"/>
          </svg>
        </button>
        <a class="idle-action" href="/">退出挂机</a>
      </div>
    </div>

    <article class="idle-card card">
      <div class="clock">
        <span id="idle-time">--:--</span>
        <span id="idle-seconds" class="seconds">--</span>
      </div>
      <div class="idle-meta">
        <span id="idle-date"></span>
        <span class="meta-divider" aria-hidden="true"></span>
        <span id="idle-weather" class="weather"></span>
      </div>
      <div class="identity">
        <img class="avatar" src="/images/avatar.jpg" alt="R03montia 头像" />
        <div class="identity-text">
          <strong>R03montia</strong>
          <span>@R03montia</span>
          <p>去做各种各样的梦吧。</p>
        </div>
      </div>
    </article>

    <p class="idle-quote" id="idle-quote"></p>
  </section>
</BaseLayout>

<style>
  .idle-stage {
    position: relative;
    height: 100dvh;
    display: grid;
    place-items: center;
    padding: 6rem clamp(1rem, 4vw, 2.5rem) 4rem;
  }

  .idle-top {
    position: fixed;
    top: 1rem;
    left: 1rem;
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0.45rem;
    font-family: var(--font-ui);
  }

  .idle-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    align-items: center;
    gap: 0.45rem;
  }

  .idle-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2rem;
    padding: 0.3rem 0.6rem;
    border: 1px solid rgb(var(--line) / 0.45);
    border-radius: 999px;
    background: rgb(var(--content-bg) / 0.5);
    backdrop-filter: blur(0.8rem);
    -webkit-backdrop-filter: blur(0.8rem);
    color: rgb(var(--text-secondary));
    font-family: var(--font-ui);
    font-size: 0.78rem;
    line-height: 1;
    cursor: pointer;
    text-decoration: none;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
  }

  .idle-action:hover {
    color: rgb(var(--text));
    border-color: rgb(var(--accent) / 0.5);
    background: rgb(var(--content-bg) / 0.72);
    text-decoration: none;
    transform: translateY(-1px);
  }

  .idle-action:focus-visible {
    outline: 2px solid rgb(var(--accent) / 0.6);
    outline-offset: 2px;
  }

  .idle-action:disabled {
    opacity: 0.4;
    cursor: not-allowed;
    transform: none;
  }

  #theme-toggle,
  #rain-toggle {
    width: 2rem;
    min-height: 2rem;
    padding: 0;
  }

  #theme-toggle svg,
  #rain-toggle svg {
    width: 1rem;
    height: 1rem;
  }

  #theme-toggle .icon-moon,
  #rain-toggle .icon-rain-off {
    display: none;
  }

  :global([data-theme='dark']) #theme-toggle .icon-sun,
  :global(html:not([data-rainy])) #rain-toggle .icon-rain {
    display: none;
  }

  :global([data-theme='dark']) #theme-toggle .icon-moon,
  :global(html:not([data-rainy])) #rain-toggle .icon-rain-off {
    display: block;
  }

  .idle-card {
    width: min(52rem, 100%);
    padding: clamp(2rem, 6vw, 4rem) clamp(1.5rem, 6vw, 4rem);
    border: 1px solid rgb(var(--line) / 0.32);
    border-radius: 18px;
    text-align: center;
  }

  .clock {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.35em;
    color: rgb(var(--text));
    font-family: var(--font-deco);
    font-size: clamp(4.2rem, 15vw, 10.5rem);
    font-weight: 400;
    line-height: 0.88;
    letter-spacing: 0.035em;
    user-select: none;
  }

  .seconds {
    color: rgb(var(--text-secondary));
    font-size: 0.24em;
    line-height: 1;
    transform: translateY(-0.2em);
  }

  .idle-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.55rem 0.9rem;
    margin-top: 1.4rem;
    color: rgb(var(--text-secondary));
    font-family: var(--font-ui);
    font-size: 0.9rem;
  }

  .meta-divider {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: currentColor;
  }

  .weather {
    color: rgb(var(--text-secondary));
  }

  .weather :global(button) {
    min-height: 1.8rem;
    padding: 0.2rem 0.6rem;
    border: 1px solid rgb(var(--line) / 0.45);
    border-radius: 999px;
    background: rgb(var(--content-bg) / 0.55);
    color: rgb(var(--text-secondary));
    font-family: var(--font-ui);
    font-size: 0.8rem;
    cursor: pointer;
  }

  .weather :global(button:hover) {
    color: rgb(var(--text));
    border-color: rgb(var(--accent) / 0.5);
    background: rgb(var(--content-bg) / 0.75);
  }

  .identity {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: clamp(2rem, 5vw, 3rem);
    text-align: left;
  }

  .avatar {
    width: 2.7rem;
    height: 2.7rem;
    flex-shrink: 0;
    border: 1px solid rgb(var(--line) / 0.5);
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 2px 8px -2px rgba(0, 0, 0, 0.22);
  }

  .identity-text {
    display: grid;
    gap: 0.1rem;
    font-family: var(--font-ui);
  }

  .identity-text strong {
    font-size: 1rem;
    letter-spacing: 0.04em;
  }

  .identity-text span {
    color: rgb(var(--text-secondary));
    font-size: 0.78rem;
  }

  .identity-text p {
    margin: 0.35rem 0 0;
    color: rgb(var(--text-secondary));
    font-size: 0.85rem;
  }

  .idle-quote {
    position: absolute;
    left: clamp(1rem, 4vw, 2rem);
    right: clamp(1rem, 4vw, 2rem);
    bottom: clamp(1rem, 3vw, 1.5rem);
    margin: 0;
    color: rgb(var(--text-secondary) / 0.72);
    font-family: var(--font-ui);
    font-size: 0.82rem;
    line-height: 1.6;
    text-align: center;
  }

  .idle-quote cite {
    color: rgb(var(--text-secondary) / 0.55);
    font-style: normal;
    font-size: 0.76rem;
  }

  @media (max-width: 40rem) {
    .idle-stage {
      padding-top: 8.5rem;
    }

    .idle-top {
      flex-direction: column;
      align-items: flex-start;
    }
    .idle-card {
      padding: 2.2rem 1.35rem;
    }

    .identity {
      text-align: center;
      flex-direction: column;
    }
  }
</style>

<script>
  type Geo = { lat: number; lon: number };
  type WakeLockLike = { release: () => Promise<void>; addEventListener?: (type: 'release', listener: () => void) => void };
  type WakeLockNavigator = Navigator & { wakeLock?: { request: (type: 'screen') => Promise<WakeLockLike> } };
  type WeatherResponse = {
    current?: {
      temperature_2m?: number;
      apparent_temperature?: number;
      weather_code?: number;
    };
  };

  const idleState = {
    clockTimer: 0 as ReturnType<typeof setInterval> | 0,
    weatherTimer: 0 as ReturnType<typeof setInterval> | 0,
    weatherGeo: null as Geo | null,
    wakeLock: null as WakeLockLike | null,
    wakeWanted: false,
  };

  const weatherDescriptions: Record<number, string> = {
    0: '晴',
    1: '基本晴朗',
    2: '局部多云',
    3: '阴',
    45: '雾',
    48: '雾凇',
    51: '毛毛雨',
    53: '毛毛雨',
    55: '毛毛雨',
    56: '冻毛毛雨',
    57: '冻毛毛雨',
    61: '小雨',
    63: '中雨',
    65: '大雨',
    66: '冻雨',
    67: '冻雨',
    71: '小雪',
    73: '中雪',
    75: '大雪',
    77: '雪粒',
    80: '阵雨',
    81: '阵雨',
    82: '强阵雨',
    85: '阵雪',
    86: '阵雪',
    95: '雷阵雨',
    96: '雷阵雨伴冰雹',
    99: '雷阵雨伴冰雹',
  };

  const getWeatherBox = () => document.getElementById('idle-weather');
  const getWakeButton = () => document.getElementById('idle-wake');
  const getFullscreenButton = () => document.getElementById('idle-fullscreen');
  const wakeLockApi = () => (navigator as WakeLockNavigator).wakeLock;

  const readGeo = (): Geo | null => {
    try {
      const raw = localStorage.getItem('idle-weather-location');
      if (!raw) return null;
      const parsed = JSON.parse(raw) as Partial<Geo>;
      if (typeof parsed.lat !== 'number' || typeof parsed.lon !== 'number') return null;
      return { lat: parsed.lat, lon: parsed.lon };
    } catch {
      return null;
    }
  };

  const updateClock = () => {
    const timeNode = document.getElementById('idle-time');
    const secondsNode = document.getElementById('idle-seconds');
    const dateNode = document.getElementById('idle-date');
    if (!timeNode || !secondsNode || !dateNode) return;

    const now = new Date();
    const hh = String(now.getHours()).padStart(2, '0');
    const mm = String(now.getMinutes()).padStart(2, '0');
    const ss = String(now.getSeconds()).padStart(2, '0');
    timeNode.textContent = `${hh}:${mm}`;
    secondsNode.textContent = ss;
    dateNode.textContent = new Intl.DateTimeFormat('zh-CN', {
      month: 'long',
      day: 'numeric',
      weekday: 'long',
    }).format(now);
  };

  const setWeatherText = (text: string) => {
    const box = getWeatherBox();
    if (box) box.textContent = text;
  };

  const loadWeather = async (geo: Geo) => {
    setWeatherText('正在获取天气…');
    const url = new URL('https://api.open-meteo.com/v1/forecast');
    url.searchParams.set('latitude', String(geo.lat));
    url.searchParams.set('longitude', String(geo.lon));
    url.searchParams.set('current', 'temperature_2m,apparent_temperature,weather_code');
    url.searchParams.set('timezone', 'auto');

    try {
      const response = await fetch(url, { cache: 'no-store' });
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      const data = (await response.json()) as WeatherResponse;
      const current = data.current;
      if (typeof current?.temperature_2m !== 'number') throw new Error('缺少天气数据');
      const description = weatherDescriptions[current.weather_code ?? -1] ?? '天气未知';
      const temperature = Math.round(current.temperature_2m);
      const apparent = typeof current.apparent_temperature === 'number'
        ? ` · 体感 ${Math.round(current.apparent_temperature)}°`
        : '';
      setWeatherText(`${description} · ${temperature}°${apparent}`);
    } catch {
      setWeatherText('天气暂时不可用');
    }
  };

  const scheduleWeather = (geo: Geo) => {
    idleState.weatherGeo = geo;
    void loadWeather(geo);
    if (idleState.weatherTimer) clearInterval(idleState.weatherTimer);
    idleState.weatherTimer = setInterval(() => void loadWeather(geo), 10 * 60 * 1000);
  };

  const requestLocation = () => {
    if (!('geolocation' in navigator)) {
      setWeatherText('当前浏览器不支持定位');
      return;
    }

    setWeatherText('正在定位…');
    navigator.geolocation.getCurrentPosition(
      (position) => {
        const geo: Geo = {
          lat: Number(position.coords.latitude.toFixed(2)),
          lon: Number(position.coords.longitude.toFixed(2)),
        };
        try {
          localStorage.setItem('idle-weather-location', JSON.stringify(geo));
        } catch {
          // localStorage 不可用时仍可在本次会话中显示天气。
        }
        scheduleWeather(geo);
      },
      (error) => {
        setWeatherText(error.code === error.PERMISSION_DENIED ? '定位被拒绝，可稍后重试' : '暂时无法定位');
      },
      { timeout: 10000, maximumAge: 10 * 60 * 1000, enableHighAccuracy: false },
    );
  };

  const renderWeatherEntry = () => {
    const box = getWeatherBox();
    if (!box) return;
    const storedGeo = readGeo();
    if (storedGeo) {
      scheduleWeather(storedGeo);
      return;
    }

    requestLocation();
  };

  const syncFullscreenButton = () => {
    const button = getFullscreenButton();
    if (!button) return;
    const active = Boolean(document.fullscreenElement);
    button.textContent = active ? '退出全屏' : '全屏';
    button.setAttribute('aria-pressed', String(active));
  };

  const toggleFullscreen = async () => {
    try {
      if (document.fullscreenElement) await document.exitFullscreen();
      else await document.documentElement.requestFullscreen();
    } catch {
      // 浏览器拒绝全屏时保持页面可用。
    }
  };

  const syncWakeButton = () => {
    const button = getWakeButton();
    if (!button) return;
    const supported = Boolean(wakeLockApi());
    const active = Boolean(idleState.wakeLock);
    button.disabled = !supported;
    button.textContent = active ? '已保持常亮' : '保持常亮';
    button.setAttribute('aria-pressed', String(active));
    if (!supported) button.title = '当前浏览器不支持屏幕常亮';
  };

  const requestWakeLock = async () => {
    const api = wakeLockApi();
    if (!api || idleState.wakeLock) return;
    try {
      const lock = await api.request('screen');
      idleState.wakeLock = lock;
      lock.addEventListener?.('release', () => {
        idleState.wakeLock = null;
        syncWakeButton();
      });
      syncWakeButton();
    } catch {
      idleState.wakeWanted = false;
      syncWakeButton();
    }
  };

  const toggleWakeLock = async () => {
    if (!wakeLockApi()) return;
    idleState.wakeWanted = !idleState.wakeWanted;
    if (idleState.wakeWanted) {
      await requestWakeLock();
      return;
    }
    await idleState.wakeLock?.release();
    idleState.wakeLock = null;
    syncWakeButton();
  };

  const cleanupIdlePage = () => {
    if (idleState.clockTimer) {
      clearInterval(idleState.clockTimer);
      idleState.clockTimer = 0;
    }
    if (idleState.weatherTimer) {
      clearInterval(idleState.weatherTimer);
      idleState.weatherTimer = 0;
    }
    idleState.weatherGeo = null;
    idleState.wakeWanted = false;
    void idleState.wakeLock?.release();
    idleState.wakeLock = null;
  };

  const loadQuote = async () => {
    const node = document.getElementById('idle-quote');
    if (!node) return;
    try {
      const response = await fetch('https://v1.hitokoto.cn/', { cache: 'no-store' });
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      const data = (await response.json()) as { hitokoto?: string; from?: string };
      const text = data.hitokoto?.trim();
      const source = data.from?.trim();
      if (!text) throw new Error('缺少一言内容');
      node.replaceChildren(
        document.createTextNode(text),
        source ? Object.assign(document.createElement('cite'), { textContent: ` —— ${source}` }) : null,
      );
    } catch {
      node.textContent = '一言暂时不可用。';
    }
  };

  const initIdlePage = () => {
    const root = document.getElementById('idle-stage');
    if (!root || root.dataset.idleBound === 'true') return;
    root.dataset.idleBound = 'true';

    updateClock();
    renderWeatherEntry();
    void loadQuote();
    syncFullscreenButton();
    syncWakeButton();

    if (idleState.clockTimer) clearInterval(idleState.clockTimer);
    idleState.clockTimer = setInterval(updateClock, 1000);

    getFullscreenButton()?.addEventListener('click', () => void toggleFullscreen());
    getWakeButton()?.addEventListener('click', () => void toggleWakeLock());
  };

  if (!(window as unknown as { __idlePageReady?: boolean }).__idlePageReady) {
    (window as unknown as { __idlePageReady?: boolean }).__idlePageReady = true;
    document.addEventListener('astro:page-load', initIdlePage);
    document.addEventListener('astro:before-swap', cleanupIdlePage);
    document.addEventListener('fullscreenchange', syncFullscreenButton);
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible' && idleState.wakeWanted && !idleState.wakeLock) {
        void requestWakeLock();
      }
    });
  }

  initIdlePage();
</script>
