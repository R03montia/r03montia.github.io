---
const items = [
  { href: '/', label: '首页', icon: 'home' },
  { href: '/blog/', label: '博客', icon: 'pen' },
  { href: '/projects/', label: '项目', icon: 'code' },
  { href: '/about/', label: '关于', icon: 'user' },
  { href: '/idle/', label: '挂机', icon: 'screen' },
];
const icons: Record<string, string> = {
  home: '<path d="M3 10.5L12 4l9 6.5V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-9.5z"/><path d="M9 21V13h6v8"/>',
  pen: '<path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>',
  code: '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>',
  user: '<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>',
  screen: '<rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8"/><path d="M12 17v4"/>',
};
const current = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? current === '/' : current.startsWith(href);
---
<aside id="main-sidebar" class="sidebar" transition:persist>
  <a class="brand" href="/">
    <img class="brand-avatar" src="/images/avatar.jpg" alt="R03montia 头像" />
    <span class="brand-text">
      <span class="brand-name">R03montia</span>
      <span class="brand-sub">@R03montia</span>
    </span>
  </a>
  <nav aria-label="主导航">
    {items.map((it) => (
      <a class:list={['side-link', { active: isActive(it.href) }]} href={it.href} data-nav-link aria-current={isActive(it.href) ? 'page' : undefined}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons[it.icon]} />
        <span>{it.label}</span>
      </a>
    ))}
  </nav>
  <div class="side-search">
    <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
    <input id="site-search" type="search" placeholder="搜索文章、标签…" aria-label="站内搜索" autocomplete="off" />
    <div id="search-results" role="listbox" aria-label="搜索结果"></div>
  </div>
  <div class="side-foot">
    <span class="socials"><a class="social" href="https://github.com/R03montia" target="_blank" rel="noopener noreferrer">GitHub</a><a class="social" href="/rss.xml">RSS</a></span>
    <div class="side-toggles">
      <button id="theme-toggle" type="button" aria-label="切换明暗模式" title="切换明暗模式">
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>
      <button id="rain-toggle" type="button" aria-label="切换下雨效果" title="切换下雨效果">
        <svg class="icon-rain" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242"/>
          <path d="M16 14v6"/><path d="M8 14v6"/><path d="M12 16v6"/>
        </svg>
        <svg class="icon-rain-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M2 2l20 20"/>
          <path d="M5.782 5.782A7 7 0 0 0 9 19h8.5a4.5 4.5 0 0 0 1.307-.193"/>
          <path d="M21.532 16.5A4.5 4.5 0 0 0 17.5 10h-1.79A7.008 7.008 0 0 0 10 5.07"/>
        </svg>
      </button>
    </div>
  </div>
</aside>

<style>
  .sidebar {
    position: sticky;
    top: 0;
    height: 100vh;
    width: 14rem;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 2rem 1.25rem;
    border-right: 1px solid rgb(var(--line) / 0.4);
  }
  .brand { display: flex; align-items: center; gap: 0.75rem; color: inherit; }
  .brand-avatar {
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    border: 1px solid rgb(var(--line) / 0.5);
    box-shadow: 0 2px 8px -2px rgba(0, 0, 0, 0.25);
  }
  .brand-text { display: flex; flex-direction: column; min-width: 0; }
  .brand-name { font-family: var(--font-ui); font-size: 1.15rem; letter-spacing: 0.05em; }
  .brand-sub { font-size: 0.75rem; color: rgb(var(--text-secondary)); }
  nav { display: flex; flex-direction: column; gap: 0.25rem; }
  .side-link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.65rem;
    border-radius: 6px;
    color: rgb(var(--text));
    font-family: var(--font-ui);
    font-size: 0.92rem;
  }
  .side-link:hover { background: rgb(var(--content-bg) / 0.7); text-decoration: none; }
  .side-link.active { background: rgb(var(--content-bg) / 0.9); box-shadow: 0 1px 0 rgb(var(--line) / 0.4); }
  .side-link svg { width: 17px; height: 17px; }
  .side-foot { margin-top: auto; display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem; }
  .side-toggles { display: flex; gap: 0.4rem; }
  .socials { display: flex; gap: 0.8rem; }
  .social { color: rgb(var(--text-secondary)); }
  #theme-toggle,
  #rain-toggle {
    border: 1px solid rgb(var(--line) / 0.6);
    background: rgb(var(--content-bg) / 0.6);
    color: rgb(var(--text));
    border-radius: 6px;
    padding: 0.3rem 0.6rem;
    cursor: pointer;
    font-family: var(--font-ui);
  }
  #theme-toggle {
    width: 2rem;
    height: 2rem;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #theme-toggle svg { width: 1rem; height: 1rem; }
  #theme-toggle .icon-moon { display: none; }
  :global([data-theme='dark']) #theme-toggle .icon-sun { display: none; }
  :global([data-theme='dark']) #theme-toggle .icon-moon { display: block; }

  #rain-toggle {
    width: 2rem;
    height: 2rem;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #rain-toggle svg { width: 1rem; height: 1rem; display: block; }
  #rain-toggle .icon-rain-off { display: none; }
  :global(html:not([data-rainy])) #rain-toggle .icon-rain { display: none; }
  :global(html:not([data-rainy])) #rain-toggle .icon-rain-off { display: block; }

  /* 搜索 */
  .side-search { position: relative; }
  :global(.side-search .search-icon) {
    position: absolute;
    left: 0.7rem;
    top: 50%;
    transform: translateY(-50%);
    width: 0.9rem;
    height: 0.9rem;
    color: rgb(var(--text-secondary) / 0.8);
    pointer-events: none;
  }
  .side-search:focus-within .search-icon { color: rgb(var(--accent)); }
  :global(#site-search) {
    width: 100%;
    height: 2.25rem;
    padding: 0 0.8rem 0 2.1rem;
    font-family: var(--font-ui);
    font-size: 0.85rem;
    color: rgb(var(--text));
    background: rgb(var(--content-bg) / 0.55);
    border: 1px solid rgb(var(--line) / 0.5);
    border-radius: 12px;
    outline: none;
    transition: border-color 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
  }
  #site-search::placeholder { color: rgb(var(--text-secondary) / 0.7); }
  :global(#site-search:focus) {
    border-color: rgb(var(--accent) / 0.8);
    background: rgb(var(--content-bg) / 0.75);
    box-shadow: 0 0 0 3px rgb(var(--accent) / 0.15);
  }
  #site-search::-webkit-search-cancel-button { cursor: pointer; }
  :global(#search-results) {
    position: absolute;
    top: calc(100% + 0.4rem);
    left: 0;
    right: 0;
    max-height: 60vh;
    overflow-y: auto;
    border-radius: 14px;
    padding: 0.4rem;
    background: rgb(var(--content-bg) / 0.92);
    backdrop-filter: blur(1rem);
    -webkit-backdrop-filter: blur(1rem);
    border: 1px solid rgb(var(--line) / 0.5);
    box-shadow: 0 16px 40px -12px rgba(0, 0, 0, 0.35);
    display: none;
    z-index: 20;
  }
  :global(#search-results.open) {
    display: block;
    animation: sr-pop 0.16s ease-out;
  }
  @keyframes sr-pop {
    from { opacity: 0; transform: translateY(-4px) scale(0.99); }
    to { opacity: 1; transform: none; }
  }
  :global(#search-results a) {
    position: relative;
    display: block;
    padding: 0.55rem 0.7rem 0.55rem 0.9rem;
    border-radius: 10px;
    color: rgb(var(--text));
    overflow: hidden;
    transition: background 0.15s ease;
  }
  #search-results a + a { margin-top: 2px; }
  :global(#search-results a::before) {
    content: "";
    position: absolute;
    left: 0;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 3px;
    border-radius: 99px;
    background: rgb(var(--accent));
    opacity: 0;
    transform: scaleY(0.6);
    transition: opacity 0.15s ease, transform 0.15s ease;
  }
  #search-results a:hover { background: rgb(var(--accent) / 0.12); text-decoration: none; }
  #search-results a:hover::before { opacity: 1; transform: none; }
  :global(#search-results .sr-title) {
    font-family: var(--font-ui);
    font-size: 0.88rem;
    font-weight: 650;
    display: block;
    line-height: 1.4;
  }
  :global(#search-results .sr-title::after) {
    content: "\2197";
    float: right;
    margin-left: 0.4rem;
    font-size: 0.75rem;
    color: rgb(var(--text-secondary));
    opacity: 0;
    transition: opacity 0.15s ease;
  }
  #search-results a:hover .sr-title::after { opacity: 0.8; }
  :global(#search-results .sr-tag) {
    background: rgb(var(--accent) / 0.14);
    border: 1px solid rgb(var(--accent) / 0.35);
  }
  #search-results .sr-tag:hover { background: rgb(var(--accent) / 0.2); }
  :global(#search-results .sr-excerpt) {
    font-size: 0.74rem;
    color: rgb(var(--text-secondary));
    margin-top: 0.15rem;
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  :global(#search-results mark) {
    background: rgb(var(--accent) / 0.25);
    color: inherit;
    font-weight: 600;
    border-radius: 4px;
    padding: 0 2px;
  }
  :global(#search-results .sr-empty) {
    padding: 1rem 0.8rem;
    font-size: 0.78rem;
    text-align: center;
    color: rgb(var(--text-secondary));
  }
  @media (prefers-reduced-motion: reduce) {
    #search-results.open { animation: none; }
    #search-results a, #search-results a::before { transition: none; }
  }
</style>
