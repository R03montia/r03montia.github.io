---
const items = [
  { href: '/', label: '首页', icon: 'home' },
  { href: '/blog/', label: '博客', icon: 'pen' },
  { href: '/projects/', label: '项目', icon: 'code' },
  { href: '/about/', label: '关于', icon: 'user' },
  { href: '/idle/', label: '挂机', icon: 'screen' },
];
const icons: Record<string, string> = {
  home: '<path d="M3 10.5L12 4l9 6.5V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-9.5z"/><path d="M9 21V13h6v8"/>',
  pen: '<path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>',
  code: '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>',
  user: '<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>',
  screen: '<rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8"/><path d="M12 17v4"/>',
};
const current = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? current === '/' : current.startsWith(href);
---
<aside id="main-sidebar" class="sidebar" transition:persist>
  <a class="brand" href="/">
    <img class="brand-avatar" src="/images/avatar.jpg" alt="R03montia 头像" />
    <span class="brand-text">
      <span class="brand-name">R03montia</span>
      <span class="brand-sub">@R03montia</span>
    </span>
  </a>
  <nav aria-label="主导航">
    {items.map((it) => (
      <a class:list={['side-link', { active: isActive(it.href) }]} href={it.href} data-nav-link aria-current={isActive(it.href) ? 'page' : undefined}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons[it.icon]} />
        <span>{it.label}</span>
      </a>
    ))}
  </nav>
  <div class="side-search">
    <input id="site-search" type="search" placeholder="搜索…" aria-label="站内搜索" autocomplete="off" />
    <div id="search-results" role="listbox" aria-label="搜索结果"></div>
  </div>
  <div class="side-foot">
    <a class="social" href="https://github.com/R03montia" target="_blank" rel="noopener noreferrer">GitHub</a>
    <div class="side-toggles">
      <button id="theme-toggle" type="button" aria-label="切换明暗模式" title="切换明暗模式">
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>
      <button id="rain-toggle" type="button" aria-label="切换下雨效果" title="切换下雨效果">
        <svg class="icon-rain" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242"/>
          <path d="M16 14v6"/><path d="M8 14v6"/><path d="M12 16v6"/>
        </svg>
        <svg class="icon-rain-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M2 2l20 20"/>
          <path d="M5.782 5.782A7 7 0 0 0 9 19h8.5a4.5 4.5 0 0 0 1.307-.193"/>
          <path d="M21.532 16.5A4.5 4.5 0 0 0 17.5 10h-1.79A7.008 7.008 0 0 0 10 5.07"/>
        </svg>
      </button>
    </div>
  </div>
</aside>

<style>
  .sidebar {
    position: sticky;
    top: 0;
    height: 100vh;
    width: 14rem;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 2rem 1.25rem;
    border-right: 1px solid rgb(var(--line) / 0.4);
  }
  .brand { display: flex; align-items: center; gap: 0.75rem; color: inherit; }
  .brand-avatar {
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    border: 1px solid rgb(var(--line) / 0.5);
    box-shadow: 0 2px 8px -2px rgba(0, 0, 0, 0.25);
  }
  .brand-text { display: flex; flex-direction: column; min-width: 0; }
  .brand-name { font-family: var(--font-ui); font-size: 1.15rem; letter-spacing: 0.05em; }
  .brand-sub { font-size: 0.75rem; color: rgb(var(--text-secondary)); }
  nav { display: flex; flex-direction: column; gap: 0.25rem; }
  .side-link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.65rem;
    border-radius: 6px;
    color: rgb(var(--text));
    font-family: var(--font-ui);
    font-size: 0.92rem;
  }
  .side-link:hover { background: rgb(var(--content-bg) / 0.7); text-decoration: none; }
  .side-link.active { background: rgb(var(--content-bg) / 0.9); box-shadow: 0 1px 0 rgb(var(--line) / 0.4); }
  .side-link svg { width: 17px; height: 17px; }
  .side-foot { margin-top: auto; display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem; }
  .side-toggles { display: flex; gap: 0.4rem; }
  .social { color: rgb(var(--text-secondary)); }
  #theme-toggle,
  #rain-toggle {
    border: 1px solid rgb(var(--line) / 0.6);
    background: rgb(var(--content-bg) / 0.6);
    color: rgb(var(--text));
    border-radius: 6px;
    padding: 0.3rem 0.6rem;
    cursor: pointer;
    font-family: var(--font-ui);
  }
  #theme-toggle {
    width: 2rem;
    height: 2rem;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #theme-toggle svg { width: 1rem; height: 1rem; }
  #theme-toggle .icon-moon { display: none; }
  :global([data-theme='dark']) #theme-toggle .icon-sun { display: none; }
  :global([data-theme='dark']) #theme-toggle .icon-moon { display: block; }

  #rain-toggle {
    width: 2rem;
    height: 2rem;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #rain-toggle svg { width: 1rem; height: 1rem; display: block; }
  #rain-toggle .icon-rain-off { display: none; }
  :global(html:not([data-rainy])) #rain-toggle .icon-rain { display: none; }
  :global(html:not([data-rainy])) #rain-toggle .icon-rain-off { display: block; }

  /* 搜索 */
  .side-search { position: relative; }
  #site-search {
    width: 100%;
    padding: 0.4rem 0.65rem;
    font-family: var(--font-ui);
    font-size: 0.85rem;
    color: rgb(var(--text));
    background: rgb(var(--content-bg) / 0.5);
    border: 1px solid rgb(var(--line) / 0.5);
    border-radius: 6px;
    outline: none;
  }
  #site-search:focus { border-color: rgb(var(--accent) / 0.7); background: rgb(var(--content-bg) / 0.7); }
  #search-results {
    position: absolute;
    top: calc(100% + 0.4rem);
    left: 0;
    right: 0;
    max-height: 60vh;
    overflow-y: auto;
    border-radius: 8px;
    background: rgb(var(--content-bg) / 0.85);
    backdrop-filter: blur(1rem);
    -webkit-backdrop-filter: blur(1rem);
    border: 1px solid rgb(var(--line) / 0.5);
    box-shadow: 0 8px 24px -8px rgba(0, 0, 0, 0.3);
    display: none;
    z-index: 20;
  }
  #search-results.open { display: block; }
  #search-results a {
    display: block;
    padding: 0.55rem 0.8rem;
    color: rgb(var(--text));
    border-bottom: 1px solid rgb(var(--line) / 0.3);
  }
  #search-results a:last-child { border-bottom: none; }
  #search-results a:hover { background: rgb(var(--content-bg) / 0.7); text-decoration: none; }
  #search-results .sr-title { font-family: var(--font-ui); font-size: 0.88rem; }
  #search-results .sr-excerpt {
    font-size: 0.74rem;
    color: rgb(var(--text-secondary));
    margin-top: 0.15rem;
    line-height: 1.45;
  }
  #search-results .sr-excerpt mark { background: rgb(var(--accent) / 0.3); color: inherit; border-radius: 2px; padding: 0 1px; }
  #search-results .sr-empty {
    padding: 0.6rem 0.8rem;
    font-size: 0.78rem;
    color: rgb(var(--text-secondary));
  }
</style>
